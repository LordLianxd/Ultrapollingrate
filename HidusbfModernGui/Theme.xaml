<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:HidusbfModernGui">

    <!-- Palette. Colour only ever encodes a real system fact; everything else is
         black, grey or white. No indigo, no blue. -->
    <SolidColorBrush x:Key="BgBrush"          Color="#000000"/>
    <SolidColorBrush x:Key="SurfaceBrush"     Color="#0A0A0A"/>
    <SolidColorBrush x:Key="SurfaceAltBrush"  Color="#111111"/>
    <SolidColorBrush x:Key="BorderBrush"      Color="#1F1F1F"/>
    <SolidColorBrush x:Key="TextDataBrush"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextLabelBrush"   Color="#8A8A8A"/>
    <SolidColorBrush x:Key="TextMutedBrush"   Color="#4A4A4A"/>

    <SolidColorBrush x:Key="StatusOkBrush"    Color="#00C853"/>
    <SolidColorBrush x:Key="StatusWarnBrush"  Color="#FFAB00"/>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#FF3D00"/>

    <!-- PadVisual's idle button/dpad/touchpad fill. Distinct from SurfaceAltBrush
         (#111111) because the pad's buttons need to read against the pad body
         (#0A0A0A) as a slightly-raised control, not just another panel. -->
    <SolidColorBrush x:Key="PadIdleBrush"     Color="#3A3A3A"/>

    <!-- El panel del diagrama de botones NO sigue el tema, a proposito. Su dibujo es un PNG
         de tinta oscura sobre papel blanco: si el papel siguiera a TextDataBrush, en modo dia
         el panel se volveria negro debajo de un dibujo que sigue siendo blanco. Estos dos son
         el papel y la tinta de ESE panel, y son fijos porque la imagen lo es. -->
    <SolidColorBrush x:Key="DiagramPaperBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DiagramInkBrush"   Color="#000000"/>

    <local:StatusLevelToBrushConverter x:Key="StatusToBrush"/>

    <!-- Sol y luna del interruptor de dia/noche del diagrama. Viven AQUI y no en
         MainWindow.xaml porque los usa un estilo de este mismo diccionario, y la busqueda de
         recursos sube (elemento -> ventana -> app), nunca baja: desde aqui no se veria uno
         declarado en la ventana.
         Rellenos los dos, sin trazo, para que a 15 px se lean como silueta y no como un
         garabato de lineas. Son del mismo juego de siluetas que el resto de iconos de esta
         app (Material Design Icons), que estan dibujadas para leerse pequeñas: la primera
         version, hecha a mano, daba un sol de rayos sueltos y una luna cuyos destellos se
         pegaban al creciente y parecia un pato. -->
    <Geometry x:Key="SunIconPath">M3.55,19.09L4.96,20.5L6.76,18.71L5.34,17.29M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M20,13H23V11H20M17.24,18.71L19.04,20.5L20.45,19.09L18.66,17.29M20.45,5L19.04,3.6L17.24,5.39L18.66,6.81M13,1H11V4H13M6.76,5.39L4.96,3.6L3.55,5L5.34,6.81L6.76,5.39M1,13H4V11H1M13,20H11V23H13</Geometry>
    <Geometry x:Key="MoonIconPath">M17.75,4.09L15.22,6.03L16.13,9.09L13.5,7.28L10.87,9.09L11.78,6.03L9.25,4.09L12.44,4L13.5,1L14.56,4L17.75,4.09M21.25,11L19.61,12.25L20.2,14.23L18.5,13.06L16.8,14.23L17.39,12.25L15.75,11L17.81,10.95L18.5,9L19.19,10.95L21.25,11M18.97,15.95C19.8,15.87 20.69,17.05 20.16,17.8C19.84,18.25 19.5,18.67 19.08,19.07C15.17,23 8.84,23 4.94,19.07C1.03,15.17 1.03,8.83 4.94,4.93C5.34,4.53 5.76,4.17 6.21,3.85C6.96,3.32 8.14,4.21 8.06,5.04C7.79,7.9 8.75,10.87 10.95,13.06C13.14,15.26 16.1,16.22 18.97,15.95Z</Geometry>

    <!-- Cascadia Mono is not guaranteed to be installed; Consolas is. The
         fallback chain is not optional. -->
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- Numbers are the product: tabular mono so 1000 Hz -> 500 Hz does not shift
         the layout. -->
    <Style x:Key="DataText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextDataBrush}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="RateDisplay" TargetType="TextBlock" BasedOn="{StaticResource DataText}">
        <Setter Property="FontSize" Value="46"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextLabelBrush}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="SectionHeading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextLabelBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SidebarButton" TargetType="Button">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToolTip. Left unstyled this is Aero2's white pop-up with black text and a
         blue-tinted border, exactly the "eleventh colour" this file exists to
         keep out. Implicit (no x:Key): applies to every ToolTip in the app,
         including the sidebar's, without anyone having to remember to set it. -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextDataBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            MaxWidth="320">
                        <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBoxItem. Implicit, so items added directly in code-behind (as this
         app does for DetailRateCombo) pick it up with no per-item wiring. Aero2's
         version of this is a light hover/select highlight in Aero2's system
         blue, the root cause the retemplate exists to remove, not just paper
         over. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Foreground" Value="{StaticResource TextDataBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" BorderThickness="0"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox. Implicit and fully retemplated: setting Background/Foreground
         alone (the previous state of this file) does nothing to Aero2's default
         ControlTemplate, whose triggers paint Aero2's system-blue hover and
         focus border regardless. This is the root-cause fix: no ComboBox anywhere in
         the app (DetailRateCombo, GlobalModeComboBox, or any added later) can fall
         through to system chrome, because there is no x:Key gating it. -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextDataBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- DetailRateCombo is disabled when bus speed is unknown, and its
             ToolTip carries the only explanation of why. WPF does not show
             ToolTips on disabled elements unless this is set, so without it the
             reason would go dark exactly when the user needs it most. -->
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ToggleButton x:Name="ToggleBtn" Grid.Column="0" Grid.ColumnSpan="2"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press" Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="ContentSite" Grid.Column="0" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"/>

                        <Path Grid.Column="1" Data="M4,0 L8,5 L12,0 Z" Fill="{StaticResource TextLabelBrush}"
                              Width="12" Height="6" Stretch="Uniform" HorizontalAlignment="Right"
                              VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>

                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <Border x:Name="DropDownBorder" Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <!-- Muted, not invisible: the whole point is that the disabled
                                 reason (via the ToolTip above) stays legible. Targets
                                 ToggleBtn, not the Border nested inside its own nested
                                 template; that Border's name is out of scope here. -->
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            <Setter TargetName="ToggleBtn" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CheckBox. Implicit. Aero2's default is a white square with a blue check
         and a blue focus/hover glow. The check mark here is TextDataBrush, not a
         status colour: a checkbox reflects a filter choice, not a fact about the
         driver or a device, so it does not borrow from the Ok/Warn/Error trio. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextDataBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Bd" Width="14" Height="14" Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Path x:Name="CheckMark" Data="M1.5,6 L5,9.5 L11,2" Stroke="{StaticResource TextDataBrush}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextLabelBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flat, square, bordered. No rounded pill buttons. -->
    <Style x:Key="InstrumentButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextDataBrush}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <!-- Reuses a palette token rather than inventing a hover
                                 shade: every hex in this file is one of the ten. -->
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hermano secundario de InstrumentButton: misma tipografia, mismo alto y mismo
         recuadro, pero sin relleno, para acciones de segundo plano (RESTABLECER VALORES)
         que antes iban como texto suelto y no parecian pulsables. Al pasar el raton se
         rellena igual que el primario: la unica diferencia es el estado de reposo. -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource InstrumentButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextLabelBrush}"/>
    </Style>

    <!-- Pildora de etiqueta del diagrama de botones (Task BT2), modelo "PlayStation
         Accessories": una excepcion deliberada a "sin pildoras redondeadas" de arriba,
         porque aqui la pildora ES la etiqueta flotante junto a su linea guia, no un
         boton de accion mas. Foreground y BorderBrush NO se fijan aqui (ni en un
         trigger): son el estado de REMAPEADO/no-remapeado del modelo, no del control,
         y los pone RefreshButtonPills() en code-behind tras cada cambio. -->
    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lavado del hover de las etiquetas del diagrama: 8% de negro. NO es una inversion.
         La pildora dejo de contener texto y ahora lleva formas (Path/Ellipse/Border) con su
         pincel fijado en code-behind, y esas NO heredan Foreground: al invertir el fondo a
         tinta, los iconos negros desaparecian dentro del negro. Un fondo que solo se oscurece
         un poco no puede volver a tragarse su propio contenido, pase lo que pase con el.
         Fijo, no de la paleta: vive sobre el panel del diagrama, que tampoco sigue el tema. -->
    <SolidColorBrush x:Key="DiagramPillHoverBrush" Color="#14000000"/>

    <!-- La misma pildora, pero para el panel CLARO del diagrama: el dibujo del mando es
         line art oscuro sobre papel blanco, asi que ahi la tinta es DiagramInkBrush, fija y
         no de la paleta (ver comentario junto a esos dos pinceles). Al pasar el raton solo
         se lava el fondo: invertirlo tragaba los iconos (ver DiagramPillHoverBrush). Igual
         que PillButton, el Foreground/BorderBrush del estado REMAPEADO lo pone
         RefreshButtonPills() en code-behind. -->
    <Style x:Key="PillButtonInk" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource DiagramInkBrush}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="2"
                            CornerRadius="20"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DiagramPillHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Interruptor de opcion: pastilla lisa con pulsador deslizante, para las filas
         "etiqueta a la izquierda, interruptor a la derecha" del panel de opciones del mando
         en vivo. Es el mismo lenguaje que DayNightToggle pero sin iconos: aqui lo que se
         enciende no es un dibujo, es un modo, y el nombre de la fila ya lo dice.
         Apagado: pista hundida y pulsador gris. Encendido: pista blanca y pulsador negro -
         el mismo par invertido que usa el resto de la app. -->
    <Style x:Key="SwitchToggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" CornerRadius="12"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Ellipse x:Name="Knob" Width="18" Height="18" HorizontalAlignment="Left"
                                 Margin="2,0,0,0" Fill="{StaticResource TextLabelBrush}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="KnobShift" X="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource TextDataBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource TextDataBrush}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource BgBrush}"/>
                            <!-- 20 px: lo que va de tope a tope dejando 2 px de aire a cada lado. -->
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                                         To="20" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource TextLabelBrush}"/>
                        </Trigger>
                        <!-- Deshabilitado no se oculta: "Overlay atraviesa clic" solo sirve con el
                             streamer abierto, y verlo apagado explica por que no responde. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fila de opcion: nombre a la izquierda, interruptor a la derecha, con una linea fina
         debajo que la separa de la siguiente. La ultima fila de un grupo pone
         BorderThickness="0" para no dejar una linea colgando al final. -->
    <Style x:Key="OptionRow" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="14,11"/>
    </Style>

    <Style x:Key="OptionRowLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextDataBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Interruptor de dia/noche del diagrama: una pastilla con un pulsador que se desliza.
         Un CheckBox normal aqui era feo y crudo - la casilla cuadrada no dice nada de lo que
         hace, y este control cambia un DIBUJO, asi que tiene que enseñarlo.
         El sol y la luna ocupan posiciones FIJAS (izquierda y derecha) y el pulsador tapa una
         de las dos: la que se ve es el modo en el que estas. La pastilla se invierte con el
         modo, igual que el panel que gobierna. Blanco y negro de la paleta, sin colores nuevos.
         El texto va en el ToolTip y no al lado: sol y luna se entienden solos, y la cabecera
         de esa pagina ya lleva titulo y boton de ayuda. -->
    <Style x:Key="DayNightToggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="58"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" CornerRadius="14"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Path x:Name="Sun" Data="{StaticResource SunIconPath}" Stretch="Uniform"
                                  Width="15" Height="15" HorizontalAlignment="Left" Margin="7,0,0,0"
                                  VerticalAlignment="Center" Fill="{StaticResource BgBrush}" Opacity="0"/>
                            <Path x:Name="Moon" Data="{StaticResource MoonIconPath}" Stretch="Uniform"
                                  Width="15" Height="15" HorizontalAlignment="Right" Margin="0,0,7,0"
                                  VerticalAlignment="Center" Fill="{StaticResource TextDataBrush}"/>
                            <Ellipse x:Name="Knob" Width="22" Height="22" HorizontalAlignment="Left"
                                     Margin="2,0,0,0" Fill="{StaticResource TextDataBrush}">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobShift" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource TextDataBrush}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource BgBrush}"/>
                            <Setter TargetName="Sun" Property="Opacity" Value="1"/>
                            <Setter TargetName="Moon" Property="Opacity" Value="0"/>
                            <!-- El pulsador se DESLIZA, no salta: 30 px son los que van del tope
                                 izquierdo al derecho dejando 2 px de aire a cada lado. -->
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                                         To="30" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource TextLabelBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Preset colour swatch. A Button, not the Border+MouseLeftButtonUp it used to
         be, so Tab reaches it and Enter/Space activates it like any other control.
         The ControlTemplate is just the coloured rectangle: this is the one
         sanctioned place colour is the data rather than a status, so there is no
         hover/pressed chrome fighting the colour that is the point. Focus still
         shows - nothing here sets FocusVisualStyle to null. -->
    <Style x:Key="PresetSwatchButton" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider. Implicit, like every other control type above: nothing used a
         Slider before the Light page, so nothing retemplated it, and left alone
         it is Aero2's default trackbar with a system-blue thumb highlight - the
         exact eleventh colour this file exists to keep out, even though today's
         only Sliders (the R/G/B sliders) happen not to trigger it. Track and
         thumb are flat rectangles, an instrument rather than a system control:
         BorderBrush at rest, TextLabelBrush/SurfaceAltBrush on hover,
         TextMutedBrush disabled, thumb always TextDataBrush. No new hex - every
         brush here already exists above. -->
    <Style TargetType="Slider">
        <Setter Property="Height" Value="20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border x:Name="SliderTrack" Height="2" Background="{StaticResource BorderBrush}"
                                VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                        <Track x:Name="PART_Track"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                               IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                               Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Rectangle Fill="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Rectangle Fill="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="SliderThumb" Width="10" Height="16" Background="{StaticResource TextDataBrush}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SliderTrack" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                            <Setter TargetName="SliderThumb" Property="Background" Value="{StaticResource TextLabelBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="SliderTrack" Property="Background" Value="{StaticResource TextMutedBrush}"/>
                            <Setter TargetName="SliderThumb" Property="Background" Value="{StaticResource TextMutedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tarjeta grande del hub del configurador (Task PS3), modelo "PlayStation
         Accessories": icono + titulo + frase, sin contenido fijo en la plantilla
         (el ContentPresenter deja meter lo que haga falta). El movimiento es la
         prioridad explicita del usuario: al pasar el raton escala a 1.02 en
         120ms, al pulsar baja a 0.98 en 80ms, siempre sobre el Border interno
         ("Bd") via EnterActions/ExitActions - asi la vuelta al reposo tambien
         se anima, no solo la entrada. -->
    <Style x:Key="HubCard" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="MinHeight" Value="120"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.02" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bd"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.02" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.0" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="Bd"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.0" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="0.98" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="Bd"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="0.98" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.0" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="Bd"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.0" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Boton circular de 26px: la "?" de ayuda y la tuerca de opciones del hub
         (Task PS3). Mismo lenguaje de hover que InstrumentButton (fondo sube un
         tono), solo que redondo y sin texto/padding propios. -->
    <Style x:Key="RoundIconButton" TargetType="Button">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextDataBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="13">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hyperlink style to match the dark monochrome UI -->
    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{StaticResource TextDataBrush}"/>
        <Setter Property="TextDecorations" Value="None"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="Underline"/>
                <Setter Property="Foreground" Value="{StaticResource TextDataBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
