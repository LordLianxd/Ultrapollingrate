<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:HidusbfModernGui">

    <!-- Palette. Colour only ever encodes a real system fact; everything else is
         black, grey or white. No indigo, no blue. -->
    <SolidColorBrush x:Key="BgBrush"          Color="#000000"/>
    <SolidColorBrush x:Key="SurfaceBrush"     Color="#0A0A0A"/>
    <SolidColorBrush x:Key="SurfaceAltBrush"  Color="#111111"/>
    <SolidColorBrush x:Key="BorderBrush"      Color="#1F1F1F"/>
    <SolidColorBrush x:Key="TextDataBrush"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextLabelBrush"   Color="#8A8A8A"/>
    <SolidColorBrush x:Key="TextMutedBrush"   Color="#4A4A4A"/>

    <SolidColorBrush x:Key="StatusOkBrush"    Color="#00C853"/>
    <SolidColorBrush x:Key="StatusWarnBrush"  Color="#FFAB00"/>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#FF3D00"/>

    <!-- PadVisual's idle button/dpad/touchpad fill. Distinct from SurfaceAltBrush
         (#111111) because the pad's buttons need to read against the pad body
         (#0A0A0A) as a slightly-raised control, not just another panel. -->
    <SolidColorBrush x:Key="PadIdleBrush"     Color="#3A3A3A"/>

    <!-- El panel del diagrama de botones NO sigue el tema, a proposito. Su dibujo es un PNG
         de tinta oscura sobre papel blanco: si el papel siguiera a TextDataBrush, en modo dia
         el panel se volveria negro debajo de un dibujo que sigue siendo blanco. Estos dos son
         el papel y la tinta de ESE panel, y son fijos porque la imagen lo es. -->
    <SolidColorBrush x:Key="DiagramPaperBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DiagramInkBrush"   Color="#000000"/>

    <local:StatusLevelToBrushConverter x:Key="StatusToBrush"/>

    <!-- Sol y luna del interruptor de dia/noche del diagrama. Viven AQUI y no en
         MainWindow.xaml porque los usa un estilo de este mismo diccionario, y la busqueda de
         recursos sube (elemento -> ventana -> app), nunca baja: desde aqui no se veria uno
         declarado en la ventana.
         Rellenos los dos, sin trazo, para que a 15 px se lean como silueta y no como un
         garabato de lineas. Son del mismo juego de siluetas que el resto de iconos de esta
         app (Material Design Icons), que estan dibujadas para leerse pequenas: la primera
         version, hecha a mano, daba un sol de rayos sueltos y una luna cuyos destellos se
         pegaban al creciente y parecia un pato. -->
