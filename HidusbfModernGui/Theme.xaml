    <!-- Iconos de los tres segmentos del hub del mando. Van aqui, con el sol y la luna, por
         el mismo motivo: los consume un estilo de este diccionario. El mando reutiliza el
         GamepadIconPath que ya existe en MainWindow, asi que solo faltaban estos dos. -->
    <Geometry x:Key="BulbIconPath">M12,2A7,7 0 0,0 5,9C5,11.38 6.19,13.47 8,14.74V17A1,1 0 0,0 9,18H15A1,1 0 0,0 16,17V14.74C17.81,13.47 19,11.38 19,9A7,7 0 0,0 12,2M9,21A1,1 0 0,0 10,22H14A1,1 0 0,0 15,21V20H9V21Z</Geometry>
    <Geometry x:Key="ProfileIconPath">M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z</Geometry>
    <!-- Icono de copiar, para el boton junto al hex del selector de color. -->
    <Geometry x:Key="CopyIconPath">M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z</Geometry>

    <!-- Velocimetro para la fila del efecto de color: sustituye al rotulo VELOCIDAD.
         El icono cabe donde la palabra no, y la palabra vuelve en el ToolTip. -->
    <Geometry x:Key="SpeedIconPath">M12,16A3,3 0 0,1 9,13C9,11.88 9.61,10.9 10.5,10.39L20.21,4.77L14.68,14.35C14.18,15.33 13.17,16 12,16M12,3C13.81,3 15.5,3.5 16.97,4.32L14.87,5.53C14,5.19 13,5 12,5A8,8 0 0,0 4,13C4,15.21 4.89,17.21 6.34,18.65H6.35C6.74,19.04 6.74,19.67 6.35,20.06C5.96,20.45 5.32,20.45 4.93,20.07V20.07C3.12,18.26 2,15.76 2,13A10,10 0 0,1 12,3M22,13C22,15.76 20.88,18.26 19.07,20.07V20.07C18.68,20.45 18.05,20.45 17.66,20.06C17.27,19.67 17.27,19.04 17.66,18.65V18.65C19.11,17.2 20,15.21 20,13C20,11.79 19.73,10.65 19.25,9.63L20.45,7.5C21.44,9.12 22,11 22,13Z</Geometry>

    <!-- La muestra del interruptor del arcoiris. Es una de las excepciones declaradas a
         "el color no decora": aqui el color ES el dato - dice literalmente lo que va a hacer
         el mando -, igual que los presets y el selector. -->
    <LinearGradientBrush x:Key="RainbowSwatchBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF0000" Offset="0.00"/>
        <GradientStop Color="#FFD400" Offset="0.20"/>
        <GradientStop Color="#22DD44" Offset="0.40"/>
        <GradientStop Color="#00C8FF" Offset="0.60"/>
        <GradientStop Color="#3355FF" Offset="0.80"/>
        <GradientStop Color="#CC33FF" Offset="1.00"/>
    </LinearGradientBrush>

    <!-- Ojo y ojo tachado, para plegar ESPECIFICACIONES TECNICAS. El tachado es el estado
         plegado: la barra diagonal se lee como "esto esta oculto" sin necesidad de texto. -->
    <Geometry x:Key="EyeIconPath">M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z</Geometry>
    <Geometry x:Key="EyeOffIconPath">M11.83,9L15,12.16C15,12.11 15,12.05 15,12A3,3 0 0,0 12,9C11.94,9 11.89,9 11.83,9M7.53,9.8L9.08,11.35C9.03,11.56 9,11.77 9,12A3,3 0 0,0 12,15C12.22,15 12.44,14.97 12.65,14.92L14.2,16.47C13.53,16.8 12.79,17 12,17A5,5 0 0,1 7,12C7,11.21 7.2,10.47 7.53,9.8M2,4.27L4.28,6.55L4.73,7C3.08,8.3 1.78,10 1,12C2.73,16.39 7,19.5 12,19.5C13.55,19.5 15.03,19.2 16.38,18.66L16.81,19.08L19.73,22L21,20.73L3.27,3M12,7A5,5 0 0,1 17,12C17,12.64 16.87,13.26 16.64,13.82L19.57,16.75C21.07,15.5 22.27,13.86 23,12C21.27,7.61 17,4.5 12,4.5C10.6,4.5 9.26,4.75 8,5.2L10.17,7.35C10.74,7.13 11.35,7 12,7Z</Geometry>

    <!-- Las cinco barras del LED de jugador todas encendidas: el sexto valor de PlayerLeds
         (All), que NO es un "jugador 5". -->
    <Geometry x:Key="AllLedsIconPath">M3,10H5V14H3V10M7,10H9V14H7V10M11,10H13V14H11V10M15,10H17V14H15V10M19,10H21V14H19V10Z</Geometry>
    <!-- Estrella para la cabecera de EFECTO DE LOS LED, y reloj junto al combo de velocidad de
         ese mismo efecto (cuanto tarda cada fotograma de Carga/Estrellas/Respiracion). -->
    <Geometry x:Key="StarIconPath">M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z</Geometry>
    <Geometry x:Key="ClockIconPath">M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12.5,7H11V13L15.75,15.85L16.5,14.62L12.5,12.25V7Z</Geometry>

    <Geometry x:Key="MoonIconPath">M17.75,4.09L15.22,6.03L16.13,9.09L13.5,7.28L10.87,9.09L11.78,6.03L9.25,4.09L12.44,4L13.5,1L14.56,4L17.75,4.09M21.25,11L19.61,12.25L20.2,14.23L18.5,13.06L16.8,14.23L17.39,12.25L15.75,11L17.81,10.95L18.5,9L19.19,10.95L21.25,11M18.97,15.95C19.8,15.87 20.69,17.05 20.16,17.8C19.84,18.25 19.5,18.67 19.08,19.07C15.17,23 8.84,23 4.94,19.07C1.03,15.17 1.03,8.83 4.94,4.93C5.34,4.53 5.76,4.17 6.21,3.85C6.96,3.32 8.14,4.21 8.06,5.04C7.79,7.9 8.75,10.87 10.95,13.06C13.14,15.26 16.1,16.22 18.97,15.95Z</Geometry>

    <!-- Cascadia Mono is not guaranteed to be installed; Consolas is. The
         fallback chain is not optional. -->
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- Numbers are the product: tabular mono so 1000 Hz -> 500 Hz does not shift
         the layout. -->
    <Style x:Key="DataText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextDataBrush}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="RateDisplay" TargetType="TextBlock" BasedOn="{StaticResource DataText}">
        <Setter Property="FontSize" Value="46"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextLabelBrush}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="SectionHeading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextLabelBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SidebarButton" TargetType="Button">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToolTip. Left unstyled this is Aero2's white pop-up with black text and a
         blue-tinted border, exactly the "eleventh colour" this file exists to
         keep out. Implicit (no x:Key): applies to every ToolTip in the app,
         including the sidebar's, without anyone having to remember to set it. -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextDataBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            MaxWidth="320">
                        <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBoxItem. Implicit, so items added directly in code-behind (as this
         app does for DetailRateCombo) pick it up with no per-item wiring. Aero2's
         version of this is a light hover/select highlight in Aero2's system
         blue, the root cause the retemplate exists to remove, not just paper
         over. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Foreground" Value="{StaticResource TextDataBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" BorderThickness="0"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox. Implicit and fully retemplated: setting Background/Foreground
         alone (the previous state of this file) does nothing to Aero2's default
         ControlTemplate, whose triggers paint Aero2's system-blue hover and
         focus border regardless. This is the root-cause fix: no ComboBox anywhere in
         the app (DetailRateCombo, GlobalModeComboBox, or any added later) can fall
         through to system chrome, because there is no x:Key gating it. -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextDataBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- DetailRateCombo is disabled when bus speed is unknown, and its
             ToolTip carries the only explanation of why. WPF does not show
             ToolTips on disabled elements unless this is set, so without it the
             reason would go dark exactly when the user needs it most. -->
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ToggleButton x:Name="ToggleBtn" Grid.Column="0" Grid.ColumnSpan="2"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press" Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="ContentSite" Grid.Column="0" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"/>

                        <Path Grid.Column="1" Data="M4,0 L8,5 L12,0 Z" Fill="{StaticResource TextLabelBrush}"
                              Width="12" Height="6" Stretch="Uniform" HorizontalAlignment="Right"
                              VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>

                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <Border x:Name="DropDownBorder" Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <!-- Muted, not invisible: the whole point is that the disabled
                                 reason (via the ToolTip above) stays legible. Targets
                                 ToggleBtn, not the Border nested inside its own nested
                                 template; that Border's name is out of scope here. -->
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            <Setter TargetName="ToggleBtn" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CheckBox. Implicit. Aero2's default is a white square with a blue check
         and a blue focus/hover glow. The check mark here is TextDataBrush, not a
         status colour: a checkbox reflects a filter choice, not a fact about the
         driver or a device, so it does not borrow from the Ok/Warn/Error trio. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextDataBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Bd" Width="14" Height="14" Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Path x:Name="CheckMark" Data="M1.5,6 L5,9.5 L11,2" Stroke="{StaticResource TextDataBrush}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextLabelBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flat, square, bordered. No rounded pill buttons. -->
    <Style x:Key="InstrumentButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextDataBrush}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <!-- Reuses a palette token rather than inventing a hover
                                 shade: every hex in this file is one of the ten. -->
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hermano secundario de InstrumentButton: misma tipografia, mismo alto y mismo
         recuadro, pero sin relleno, para acciones de segundo plano (RESTABLECER VALORES)
         que antes iban como texto suelto y no parecian pulsables. Al pasar el raton se
         rellena igual que el primario: la unica diferencia es el estado de reposo. -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource InstrumentButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextLabelBrush}"/>
    </Style>

    <!-- Accion primaria de una pagina, invertida: fondo blanco, letra negra. Es el mayor
         enfasis que permite una paleta monocroma, y no gasta un color de estado para
         decorar. Solo debe haber UNA visible a la vez: si dos botones gritan igual,
         ninguno destaca.
         Plantilla propia, no BasedOn de InstrumentButton: su IsMouseOver fija el fondo
         de "Bd" a BorderBrush (casi negro) sin tocar el Foreground, asi que sobre este
         boton invertido el hover dejaria letra negra sobre fondo casi negro. Igual que
         el hover de SegmentButton, que a proposito NO aclara su pastilla activa porque ya
         esta en el maximo contraste de la paleta: aqui tampoco hay adonde aclarar el
         fondo sin inventar un gris nuevo, asi que el hover NO aclara el fondo: baja la
         opacidad. Ver el trigger de IsMouseOver mas abajo. -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BgBrush}"/>
        <Setter Property="Background" Value="{StaticResource TextDataBrush}"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Opacidad, no un gris nuevo. Este boton ya esta en blanco puro:
                             no existe un blanco mas claro al que ir, y anadir un gris solo
                             para el hover gastaria un color en decorar. Bajar la opacidad
                             no cuesta pincel y deja al boton primario con respuesta al
                             puntero, que siendo la accion principal de la pagina no puede
                             quedarse en solo el cambio de cursor. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pildora de etiqueta del diagrama de botones (Task BT2), modelo "PlayStation
         Accessories": una excepcion deliberada a "sin pildoras redondeadas" de arriba,
         porque aqui la pildora ES la etiqueta flotante junto a su linea guia, no un
         boton de accion mas. Foreground y BorderBrush NO se fijan aqui (ni en un
         trigger): son el estado de REMAPEADO/no-remapeado del modelo, no del control,
         y los pone RefreshButtonPills() en code-behind tras cada cambio. -->
    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lavado del hover de las etiquetas del diagrama: 8% de negro. NO es una inversion.
         La pildora dejo de contener texto y ahora lleva formas (Path/Ellipse/Border) con su
         pincel fijado en code-behind, y esas NO heredan Foreground: al invertir el fondo a
         tinta, los iconos negros desaparecian dentro del negro. Un fondo que solo se oscurece
         un poco no puede volver a tragarse su propio contenido, pase lo que pase con el.
         Fijo, no de la paleta: vive sobre el panel del diagrama, que tampoco sigue el tema. -->
    <SolidColorBrush x:Key="DiagramPillHoverBrush" Color="#14000000"/>

    <!-- La misma pildora, pero para el panel CLARO del diagrama: el dibujo del mando es
         line art oscuro sobre papel blanco, asi que ahi la tinta es DiagramInkBrush, fija y
         no de la paleta (ver comentario junto a esos dos pinceles). Al pasar el raton solo
         se lava el fondo: invertirlo tragaba los iconos (ver DiagramPillHoverBrush). Igual
         que PillButton, el Foreground/BorderBrush del estado REMAPEADO lo pone
         RefreshButtonPills() en code-behind. -->
    <Style x:Key="PillButtonInk" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource DiagramInkBrush}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="2"
                            CornerRadius="20"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DiagramPillHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Control segmentado: una pastilla que contiene varias pestañas y en la que solo una
         esta activa. La activa es una pastilla clara con texto oscuro; las demas son texto
         gris sobre el fondo del grupo.
         Son RadioButton y no Button a proposito: "solo uno a la vez" es exactamente lo que un
         RadioButton con GroupName hace de serie. Con botones normales habria que apagar los
         otros dos a mano en cada handler, y el dia que se anada un cuarto alguien se olvidara.
         El contenedor es SegmentGroup, que va justo debajo. -->
    <Style x:Key="SegmentButton" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextLabelBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="20,9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Seg" Background="Transparent" CornerRadius="16"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Seg" Property="Background" Value="{StaticResource TextDataBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource BgBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <!-- El hover solo aclara las INACTIVAS: sobre la activa (pastilla clara,
                             texto oscuro) aclarar el texto lo haria desaparecer. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{StaticResource TextDataBrush}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- La pastilla que agrupa los segmentos. El radio (22) es la mitad del alto que resulta
         del padding de los segmentos mas el suyo, para que los extremos queden semicirculares
         y no como un rectangulo con las esquinas limadas. -->
    <Style x:Key="SegmentGroup" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="22"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Segmento cuadrado para un numero o un icono suelto: el mismo lenguaje que
         SegmentButton (activo = pastilla clara con tinta oscura) pero al tamano de una casilla.
         Se usa para elegir jugador y brillo, donde la etiqueta es un simbolo y no una palabra. -->
    <Style x:Key="MiniSegment" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextLabelBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Seg" CornerRadius="7" Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Seg" Property="Background" Value="{StaticResource TextDataBrush}"/>
                            <Setter TargetName="Seg" Property="BorderBrush" Value="{StaticResource TextDataBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource BgBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Seg" Property="BorderBrush" Value="{StaticResource TextLabelBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextDataBrush}"/>
                        </MultiTrigger>
                        <!-- Atenuado al deshabilitarse: la fila de jugador se apaga cada vez que hay un efecto
                             de LED activo, y sin esto los seis segmentos seguian pareciendo pulsables. Un
                             control que se ve vivo y no responde miente sobre lo que puede hacer. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Interruptor de opcion: pastilla lisa con pulsador deslizante, para las filas
         "etiqueta a la izquierda, interruptor a la derecha" del panel de opciones del mando
         en vivo. Es el mismo lenguaje que DayNightToggle pero sin iconos: aqui lo que se
         enciende no es un dibujo, es un modo, y el nombre de la fila ya lo dice.
         Apagado: pista hundida y pulsador gris. Encendido: pista blanca y pulsador negro -
         el mismo par invertido que usa el resto de la app. -->
    <Style x:Key="SwitchToggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" CornerRadius="12"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Ellipse x:Name="Knob" Width="18" Height="18" HorizontalAlignment="Left"
                                 Margin="2,0,0,0" Fill="{StaticResource TextLabelBrush}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="KnobShift" X="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource TextDataBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource TextDataBrush}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource BgBrush}"/>
                            <!-- 20 px: lo que va de tope a tope dejando 2 px de aire a cada lado. -->
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                                         To="20" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource TextLabelBrush}"/>
                        </Trigger>
                        <!-- Deshabilitado no se oculta: "Overlay atraviesa clic" solo sirve con el
                             streamer abierto, y verlo apagado explica por que no responde. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fila de opcion: nombre a la izquierda, interruptor a la derecha, con una linea fina
         debajo que la separa de la siguiente. La ultima fila de un grupo pone
         BorderThickness="0" para no dejar una linea colgando al final. -->
    <Style x:Key="OptionRow" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="14,11"/>
    </Style>

    <Style x:Key="OptionRowLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{StaticResource TextDataBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Interruptor de dia/noche del diagrama: una pastilla con un pulsador que se desliza.
         Un CheckBox normal aqui era feo y crudo - la casilla cuadrada no dice nada de lo que
         hace, y este control cambia un DIBUJO, asi que tiene que ensenarlo.
         El sol y la luna ocupan posiciones FIJAS (izquierda y derecha) y el pulsador tapa una
         de las dos: la que se ve es el modo en el que estas. La pastilla se invierte con el
         modo, igual que el panel que gobierna. Blanco y negro de la paleta, sin colores nuevos.
         El texto va en el ToolTip y no al lado: sol y luna se entienden solos, y la cabecera
         de esa pagina ya lleva titulo y boton de ayuda. -->
    <Style x:Key="DayNightToggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="58"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" CornerRadius="14"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Path x:Name="Sun" Data="{StaticResource SunIconPath}" Stretch="Uniform"
                                  Width="15" Height="15" HorizontalAlignment="Left" Margin="7,0,0,0"
                                  VerticalAlignment="Center" Fill="{StaticResource BgBrush}" Opacity="0"/>
                            <Path x:Name="Moon" Data="{StaticResource MoonIconPath}" Stretch="Uniform"
                                  Width="15" Height="15" HorizontalAlignment="Right" Margin="0,0,7,0"
                                  VerticalAlignment="Center" Fill="{StaticResource TextDataBrush}"/>
                            <Ellipse x:Name="Knob" Width="22" Height="22" HorizontalAlignment="Left"
                                     Margin="2,0,0,0" Fill="{StaticResource TextDataBrush}">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobShift" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource TextDataBrush}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource BgBrush}"/>
                            <Setter TargetName="Sun" Property="Opacity" Value="1"/>
                            <Setter TargetName="Moon" Property="Opacity" Value="0"/>
                            <!-- El pulsador se DESLIZA, no salta: 30 px son los que van del tope
                                 izquierdo al derecho dejando 2 px de aire a cada lado. -->
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                                         To="30" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource TextLabelBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Preset colour swatch. A Button, not the Border+MouseLeftButtonUp it used to
         be, so Tab reaches it and Enter/Space activates it like any other control.
         The ControlTemplate is just the coloured rectangle: this is the one
         sanctioned place colour is the data rather than a status, so there is no
         hover/pressed chrome fighting the colour that is the point. Focus still
         shows - nothing here sets FocusVisualStyle to null. -->
    <Style x:Key="PresetSwatchButton" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- ContentPresenter: los ocho presets de fabrica no ponen Content, asi que
                         para ellos esto no pinta nada. El "+" de la paleta del usuario si lo usa,
                         y sin este presenter quedaria invisible sobre el rectangulo de color. -->
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Atenuado al deshabilitarse: las muestras se apagan junto con ColorSection cuando
                 el rainbow toma el color, y sin esto seguian pareciendo pulsables. Un control que
                 se ve vivo y no responde miente sobre lo que puede hacer. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Slider. Implicit, like every other control type above: nothing used a
         Slider before the Light page, so nothing retemplated it, and left alone
         it is Aero2's default trackbar with a system-blue thumb highlight - the
         exact eleventh colour this file exists to keep out, even though today's
         only Sliders (the R/G/B sliders) happen not to trigger it. Track and
         thumb are flat rectangles, an instrument rather than a system control:
         BorderBrush at rest, TextLabelBrush/SurfaceAltBrush on hover,
         TextMutedBrush disabled, thumb always TextDataBrush. No new hex - every
         brush here already exists above. -->
    <Style TargetType="Slider">
        <Setter Property="Height" Value="20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border x:Name="SliderTrack" Height="2" Background="{StaticResource BorderBrush}"
                                VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                        <Track x:Name="PART_Track"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                               IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                               Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Rectangle Fill="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Rectangle Fill="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="SliderThumb" Width="10" Height="16" Background="{StaticResource TextDataBrush}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SliderTrack" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                            <Setter TargetName="SliderThumb" Property="Background" Value="{StaticResource TextLabelBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="SliderTrack" Property="Background" Value="{StaticResource TextMutedBrush}"/>
                            <Setter TargetName="SliderThumb" Property="Background" Value="{StaticResource TextMutedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tarjeta grande del hub del configurador (Task PS3), modelo "PlayStation
         Accessories": icono + titulo + frase, sin contenido fijo en la plantilla
         (el ContentPresenter deja meter lo que haga falta). El movimiento es la
         prioridad explicita del usuario: al pasar el raton escala a 1.02 en
         120ms, al pulsar baja a 0.98 en 80ms, siempre sobre el Border interno
         ("Bd") via EnterActions/ExitActions - asi la vuelta al reposo tambien
         se anima, no solo la entrada. -->
    <Style x:Key="HubCard" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="MinHeight" Value="120"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.02" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Bd"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.02" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.0" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="Bd"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.0" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="0.98" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="Bd"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="0.98" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.0" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="Bd"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.0" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Boton circular de 26px: la "?" de ayuda y la tuerca de opciones del hub
         (Task PS3). Mismo lenguaje de hover que InstrumentButton (fondo sube un
         tono), solo que redondo y sin texto/padding propios. -->
    <Style x:Key="RoundIconButton" TargetType="Button">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextDataBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="13">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hyperlink style to match the dark monochrome UI -->
    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{StaticResource TextDataBrush}"/>
        <Setter Property="TextDecorations" Value="None"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="Underline"/>
                <Setter Property="Foreground" Value="{StaticResource TextDataBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Tarjeta de la lista de dispositivos (Task DP3), la fila de flat-row de antes
         pasada a tarjeta. Seleccionada se marca con borde blanco y fondo un punto mas
         claro, ninguno de los dos cambia el grosor: ver el comentario de BorderThickness
         mas abajo. Consumida por la fila de la lista (DP4) y por las tres tarjetas del
         detalle del dispositivo (DP5). -->
    <Style x:Key="DeviceCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <!-- Grosor constante 1 a proposito. Engordar el borde al seleccionar moveria el
             contenido 1 px cada vez que cambias de fila; la seleccion se marca con el COLOR
             del borde y el fondo, no con el grosor. -->
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- Pastilla de estado: punto de color + texto corto. El punto lleva el color del
         estado -verde, ambar o gris-; el fondo y el borde son neutros, para que el unico
         color de la pastilla siga significando exactamente una cosa. -->
    <Style x:Key="StatusChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="ChipText" TargetType="TextBlock" BasedOn="{StaticResource DataText}">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
