<Window x:Class="HidusbfModernGui.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" Width="420">
    <!-- Dialogo propio en vez del MessageBox de Windows. El nativo trae su marco gris, su
         icono azul y sus botones "Yes/No" en el idioma del sistema: rompe el tema monocromo y
         ademas contradice a una app entera en espanol. -->
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.6"/>
        </Border.Effect>
        <StackPanel Margin="22">
            <TextBlock x:Name="TitleText" Style="{StaticResource SectionHeading}" FontSize="12"/>
            <TextBlock x:Name="MessageText" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                       Foreground="{StaticResource TextDataBrush}" FontSize="12" Margin="0,10,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelBtn" Content="CANCELAR" Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click" Margin="0,0,10,0" MinWidth="96"/>
                <Button x:Name="OkBtn" Content="ACEPTAR" Style="{StaticResource PrimaryButton}"
                        Click="Ok_Click" MinWidth="96" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
