<Window x:Class="HidusbfModernGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HidusbfModernGui"
        mc:Ignorable="d"
        Title="UltraPolling"
        Icon="app.ico"
        Height="740" Width="1080"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- SVG Icon Geometries. Only the ones a live Path still binds to. -->
        <Geometry x:Key="CloseIconPath">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</Geometry>
        <Geometry x:Key="MinIconPath">M20,14H4V12H20V14Z</Geometry>
        <Geometry x:Key="MaxIconPath">M4,4H20V20H4V4M6,8V18H18V8H6Z</Geometry>
        <Geometry x:Key="RestoreIconPath">M4,8H8V4H20V16H16V20H4V8M16,8V14H18V6H10V8H16M6,12V18H14V12H6Z</Geometry>
        <Geometry x:Key="MouseIconPath">M12,2A7,7 0 0,0 5,9V15A7,7 0 0,0 12,22A7,7 0 0,0 19,15V9A7,7 0 0,0 12,2M17,15A5,5 0 0,1 12,20A5,5 0 0,1 7,15V14H17V15M17,12.5H7V9A5,5 0 0,1 11,4.1V11H13V4.1A5,5 0 0,1 17,9V12.5Z</Geometry>
        <Geometry x:Key="KeyboardIconPath">M19,4H5A2,2 0 0,0 3,6V18A2,2 0 0,0 5,20H19A2,2 0 0,0 21,18V6A2,2 0 0,0 19,4M19,18H5V6H19V18M6,8H8V10H6V8M9,8H11V10H9V8M12,8H14V10H12V8M15,8H17V10H15V8M6,11H8V13H6V11M9,11H11V13H9V11M12,11H14V13H12V11M15,11H17V13H15V11M8,14H16V16H8V14Z</Geometry>
        <Geometry x:Key="GamepadIconPath">M21,6H3C1.9,6 1,6.9 1,8V16C1,17.1 1.9,18 3,18H21C22.1,18 23,17.1 23,16V8C23,6.9 22.1,6 21,6M6,15H4V13H2V11H4V9H6V11H8V13H6V15M15,11A1.5,1.5 0 1,1 16.5,9.5A1.5,1.5 0 0,1 15,11M19,14A1.5,1.5 0 1,1 20.5,12.5A1.5,1.5 0 0,1 19,14Z</Geometry>
        <Geometry x:Key="UsbIconPath">M12,2A2,2 0 0,1 14,4V6H15A1,1 0 0,1 16,7V9H18V6H17V4H21V6H20V9C20,10.1 19.1,11 18,11H14V16.18C15.2,16.57 16,17.68 16,19A3,3 0 0,1 13,22A3,3 0 0,1 10,19C10,17.68 10.8,16.57 12,16.18V11H8C6.9,11 6,10.1 6,9V6H5V4H9V6H8V9H10V6A1,1 0 0,1 11,5H12V4A2,2 0 0,1 12,2M13,19A1,1 0 0,0 12,18A1,1 0 0,0 11,19A1,1 0 0,0 12,20A1,1 0 0,0 13,19Z</Geometry>
        <Geometry x:Key="RefreshIconPath">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</Geometry>
        <Geometry x:Key="HomeIconPath">M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z</Geometry>
        <Geometry x:Key="SettingsIconPath">M19.14,12.94C19.18,12.63 19.2,12.32 19.2,12C19.2,11.68 19.18,11.37 19.14,11.06L21.32,9.36C21.52,9.2 21.58,8.92 21.45,8.7L19.38,5.1C19.25,4.88 18.98,4.8 18.76,4.89L16.2,5.92C15.67,5.5 15.09,5.17 14.47,4.92L14.08,2.19C14.04,1.96 13.84,1.8 13.6,1.8H9.4C9.16,1.8 8.96,1.96 8.92,2.19L8.53,4.92C7.91,5.17 7.33,5.5 6.8,5.92L4.24,4.89C4.02,4.8 3.75,4.88 3.62,5.1L1.55,8.7C1.42,8.92 1.48,9.2 1.68,9.36L3.86,11.06C3.82,11.37 3.8,11.68 3.8,12C3.8,12.32 3.82,12.63 3.86,12.94L1.68,14.64C1.48,14.8 1.42,15.08 1.55,15.3L3.62,18.9C3.75,19.12 4.02,19.2 4.24,19.11L6.8,18.08C7.33,18.5 7.91,18.83 8.53,19.08L8.92,21.81C8.96,22.04 9.16,22.2 9.4,22.2H13.6C13.84,22.2 14.04,22.04 14.08,21.81L14.47,19.08C15.09,18.83 15.67,18.5 16.2,18.08L18.76,19.11C18.98,19.2 19.25,19.12 19.38,18.9L21.45,15.3C21.58,15.08 21.52,14.8 21.32,14.64L19.14,12.94Z</Geometry>

        <!-- Tarjetas del hub del configurador (Task PS3). EvenOdd (el FillRule por
             defecto de Path): tres circulos anidados alternan relleno/hueco, dando
             un aro + un punto central - un stick/joystick simplificado. -->
        <Geometry x:Key="StickIconPath">M4,12A8,8 0 1,0 20,12A8,8 0 1,0 4,12M6,12A6,6 0 1,0 18,12A6,6 0 1,0 6,12M10,12A2,2 0 1,0 14,12A2,2 0 1,0 10,12Z</Geometry>
        <!-- Tres barras horizontales de distinto largo: el mismo lenguaje visual que
             un control de rango/nivel, para "recorrido de los gatillos". -->
        <Geometry x:Key="TriggerIconPath">M4,6H14V8H4V6M4,11H20V13H4V11M4,16H10V18H4V16Z</Geometry>
        <!-- Marco redondeado (EvenOdd: rectangulo exterior menos uno interior) que
             representa la superficie del touchpad. -->
        <Geometry x:Key="TouchpadIconPath">M4,5H20A1,1 0 0,1 21,6V18A1,1 0 0,1 20,19H4A1,1 0 0,1 3,18V6A1,1 0 0,1 4,5M5,7V17H19V7H5Z</Geometry>

        <!-- Botones de ventana (minimizar / maximizar / cerrar). Van arriba a la derecha,
             donde los busca todo el mundo. Se quedan en el gris del tema: el rojo de
             Windows al pasar por Cerrar seria el unico color de toda la app. -->
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Scrollbar -->
        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="3" Background="{StaticResource TextMutedBrush}" Margin="2,0" Width="6"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter Grid.Column="0" Grid.Row="0"/>
                            <ScrollBar Grid.Column="1" Grid.Row="0" x:Name="PART_VerticalScrollBar" Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Width="8" Background="Transparent" BorderBrush="Transparent">
                                <ScrollBar.Template>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                                <Track.Thumb>
                                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </ScrollBar.Template>
                            </ScrollBar>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Window Border with soft margins and dropshadow. Al maximizar, el code-behind
         pone a cero el margen y el redondeo de ambos bordes: si no, la ventana "maximizada"
         deja franjas de escritorio a los lados y las esquinas redondeadas quedan flotando. -->
    <Border x:Name="RootBorder" Background="{StaticResource BgBrush}" BorderThickness="0" CornerRadius="28">
        <!-- Main instrument surface inside -->
        <Border x:Name="SurfaceBorder" Background="{StaticResource SurfaceBrush}" CornerRadius="24" Margin="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="2" Opacity="0.18"/>
            </Border.Effect>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>  <!-- Sidebar Nav -->
                    <ColumnDefinition Width="*"/>   <!-- Main content pane -->
                </Grid.ColumnDefinitions>

                <!-- ================= 1. SIDEBAR NAVIGATION ================= -->
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Width="64">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <Button Style="{StaticResource SidebarButton}" Click="DashboardNavBtn_Click" ToolTip="Dispositivos">
                                <Path Data="{StaticResource HomeIconPath}" Fill="{StaticResource TextLabelBrush}" Stretch="Uniform" Width="18" Height="18"/>
                            </Button>
                            <Button Style="{StaticResource SidebarButton}" Click="LightNavBtn_Click" ToolTip="Mando: configurar y luces">
                                <Path Data="{StaticResource GamepadIconPath}" Fill="{StaticResource TextLabelBrush}" Stretch="Uniform" Width="18" Height="18"/>
                            </Button>
                            <Button Style="{StaticResource SidebarButton}" Click="SettingsNavBtn_Click" ToolTip="Sistema">
                                <Path Data="{StaticResource SettingsIconPath}" Fill="{StaticResource TextLabelBrush}" Stretch="Uniform" Width="18" Height="18"/>
                            </Button>
                        </StackPanel>

                    </Grid>
                </Border>

                <!-- ================= 2. MAIN PANEL CONTENT ================= -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>  <!-- Header Bar -->
                        <RowDefinition Height="*"/>   <!-- Dynamic page (TabControl) -->
                        <RowDefinition Height="30"/>  <!-- Status bar -->
                    </Grid.RowDefinitions>

                    <!-- Header Bar: a white spectrum animation. The driver/service readout that
                         used to live here now lives in the System view - the state did not
                         disappear, it moved. The sticky amber warning in the status bar is still
                         the channel that tells the user the driver is capped. -->
                    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Height="52" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid>
                            <!-- Bars are generated in code-behind: forty of them hand-written here
                                 would be unreadable, and each needs its own duration and phase. -->
                            <Canvas x:Name="HeaderSpectrum" ClipToBounds="True" Background="Transparent"
                                    IsHitTestVisible="False"/>

                            <!-- Minimizar / Maximizar / Cerrar, arriba a la derecha (el sitio
                                 estandar). Los Button consumen su propio MouseLeftButtonDown, asi
                                 que pulsarlos no arrastra la ventana. -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,10,0">
                                <Button Style="{StaticResource WindowButton}" Click="MinimizeButton_Click" ToolTip="Minimizar">
                                    <Path Data="{StaticResource MinIconPath}" Fill="{StaticResource TextLabelBrush}" Stretch="Uniform" Width="13" Height="13"/>
                                </Button>
                                <Button x:Name="MaximizeBtn" Style="{StaticResource WindowButton}" Click="MaximizeButton_Click" ToolTip="Maximizar">
                                    <Path x:Name="MaxIcon" Data="{StaticResource MaxIconPath}" Fill="{StaticResource TextLabelBrush}" Stretch="Uniform" Width="13" Height="13"/>
                                </Button>
                                <Button Style="{StaticResource WindowButton}" Click="CloseButton_Click" ToolTip="Cerrar">
                                    <Path Data="{StaticResource CloseIconPath}" Fill="{StaticResource TextLabelBrush}" Stretch="Uniform" Width="13" Height="13"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Content TabControl (Headers hidden) -->
                    <TabControl Grid.Row="1" x:Name="MainTabControl" Background="Transparent" BorderThickness="0" Padding="0">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </TabControl.Resources>

                        <!-- PAGE 0: DASHBOARD -->
                        <TabItem Header="Dashboard">
                            <!-- MaxWidth + centrado: maximizada a 1920 las dos columnas se
                                 estiraban y cada fila quedaba con medio metro de hueco entre
                                 el nombre del dispositivo y su tasa. Con un ancho maximo el
                                 contenido sigue denso y legible en cualquier pantalla, y el
                                 espacio de mas se reparte a los lados en vez de dentro.
                                 El panel de detalle pasa a ancho FIJO: su contenido (numero
                                 grande, tabla de campos, combo) no mejora por ser mas ancho,
                                 asi que todo el ancho extra va a la lista, que si lo usa. -->
                            <!-- Stretch y no Center: con Center el Grid se dimensiona a su CONTENIDO, y
                                 mientras se escanea la lista esta vacia, asi que la columna se encogia y
                                 el encabezado salia cortado ("DISPOSITIVC" con el boton encima). El
                                 MaxWidth sigue poniendo el techo. -->
                            <Grid Margin="24,20,24,10" MaxWidth="1500" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>   <!-- Main operations -->
                                    <ColumnDefinition Width="430"/> <!-- Monitor & Graph -->
                                </Grid.ColumnDefinitions>

                                <!-- Left Area -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Device list heading -->
                                        <RowDefinition Height="*"/>    <!-- Devices List -->
                                    </Grid.RowDefinitions>

                                    <!-- Device list heading. El boton de refrescar vive AQUI, junto a la lista
                                         que refresca, y no en la barra lateral: alli era un icono sin contexto
                                         que solo tenia sentido en esta pagina. -->
                                    <Grid Grid.Row="0" Margin="16,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="DISPOSITIVOS CONECTADOS" Style="{StaticResource SectionHeading}"/>
                                            <TextBlock Style="{StaticResource DataText}"
                                                       FontSize="11" Foreground="{StaticResource TextLabelBrush}" Margin="10,0,0,0">
                                                <Run Text="("/><Run x:Name="DeviceCountText" Text="0"/><Run Text=" de "/><Run x:Name="DeviceCountTotalText" Text="0"/><Run Text=")"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Style="{StaticResource RoundIconButton}" Click="RefreshDevicesBtn_Click"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Volver a escanear los dispositivos USB">
                                            <Path Data="{StaticResource RefreshIconPath}" Fill="{StaticResource TextLabelBrush}"
                                                  Stretch="Uniform" Width="13" Height="13"/>
                                        </Button>
                                    </Grid>

                                    <!-- Indicador de carga: anillo de puntos que giran, construido en
                                         code-behind (son 12 elipses colocadas por trigonometria). Se muestra
                                         durante una espera REAL - el escaneo de dispositivos -, no como
                                         adorno. La lista de debajo se difumina mientras tanto, para que
                                         quede claro que lo que se ve es viejo y esta a punto de cambiar. -->
                                    <Canvas x:Name="LoadingIndicator" Grid.Row="1" Width="52" Height="52"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="Collapsed" Panel.ZIndex="10">
                                        <Canvas.RenderTransform>
                                            <RotateTransform x:Name="LoadingSpin" CenterX="26" CenterY="26"/>
                                        </Canvas.RenderTransform>
                                    </Canvas>

                                    <!-- Scrollable Devices List -->
                                    <ScrollViewer x:Name="DevicesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ListBox x:Name="DevicesListBox"
                                                 Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 HorizontalContentAlignment="Stretch"
                                                 SelectionChanged="DevicesListBox_SelectionChanged">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="Row" Style="{StaticResource DeviceCard}">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource TextDataBrush}"/>
                                                                        <Setter TargetName="Row" Property="Background"  Value="{StaticResource SurfaceAltBrush}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>

                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="16,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- The icon is grey, always. Device type is not a status, so it
                                                             does not get a colour. IconKind already resolves to one of
                                                             Mouse / Keyboard / Gamepad / Usb. -->
                                                        <Path Grid.Column="0" Fill="{StaticResource TextLabelBrush}" Stretch="Uniform"
                                                              Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,14,0">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Data" Value="{StaticResource UsbIconPath}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IconKind}" Value="Mouse">
                                                                            <Setter Property="Data" Value="{StaticResource MouseIconPath}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IconKind}" Value="Keyboard">
                                                                            <Setter Property="Data" Value="{StaticResource KeyboardIconPath}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IconKind}" Value="Gamepad">
                                                                            <Setter Property="Data" Value="{StaticResource GamepadIconPath}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>

                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextDataBrush}" FontSize="13"/>
                                                            <TextBlock Text="{Binding ChildrenSummary}" Style="{StaticResource FieldLabel}"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                                                       ToolTip="{Binding ChildrenSummary}"/>

                                                            <!-- La pastilla se muestra siempre, en todas las filas: el punto es la
                                                                 unica senal de StatusLevel.Error/Warn en la lista, y esconderla
                                                                 cuando no hay tasa puesta tapaba esos dos estados. -->
                                                            <Border Style="{StaticResource StatusChip}" Margin="0,8,0,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                             Fill="{Binding StatusDot, Converter={StaticResource StatusToBrush}}"/>
                                                                    <TextBlock Text="{Binding ActiveChipText}" Style="{StaticResource ChipText}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </ScrollViewer>
                                </Grid>

                                <!-- Detail panel. Was always bound to DevicesListBox.SelectedItem —
                                     a detail panel disguised as a simulated graph. This is the honest
                                     version: it shows only what the app can prove. -->
                                <Grid Grid.Column="1" DataContext="{Binding SelectedItem, ElementName=DevicesListBox}" Margin="24">
                                    <!-- Empty state: shown until a device is picked. Better than a dash in every field. -->
                                    <TextBlock Text="Selecciona un dispositivo"
                                               VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedItem, ElementName=DevicesListBox}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedItem, ElementName=DevicesListBox}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextDataBrush}" FontSize="15" Margin="0,0,0,16"/>

                                        <!-- Tarjeta MEDIDA. MEASURED is the headline, not requested. Writing
                                             bInterval to the registry reconfigures nothing until the device is
                                             re-enumerated, so the requested value is a promise, not a fact.
                                             Showing it at 46px was the app telling the user 8000 Hz while the pad
                                             ran at 1000. The big number is now what the device is actually doing.

                                             El distintivo de regularidad (a la derecha del rotulo) dice como de
                                             REGULAR llega el flujo, no si la tasa es la pedida - eso lo dice el
                                             punto de PEDIDA, justo debajo. Son dos preguntas distintas: un mando
                                             puede ir a la tasa correcta con tirones, y uno a tasa equivocada
                                             puede ir finisimo. -->
                                        <Border Style="{StaticResource DeviceCard}">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="MEDIDA" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                                    <!-- Colapsado hasta que UpdateMeasuredReadout tenga una muestra
                                                         valida que clasificar: un distintivo con un valor viejo
                                                         junto a un numero que dice "sin datos" miente peor que no
                                                         tener distintivo. -->
                                                    <Border x:Name="SteadinessChip" Style="{StaticResource StatusChip}"
                                                            HorizontalAlignment="Right" Visibility="Collapsed">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse x:Name="SteadinessChipDot" Style="{StaticResource StatusDot}" Margin="0,0,6,0"/>
                                                            <TextBlock x:Name="SteadinessChipText" Text="" Style="{StaticResource ChipText}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <TextBlock x:Name="MeasuredText" Text="--" Style="{StaticResource RateDisplay}" Margin="0,6,0,0"/>

                                                <!-- ENTRE REPORTES, no LATENCIA: este numero es el hueco entre
                                                     llegadas de reportes HID. La latencia -el retardo desde que se
                                                     mueve el stick- esta app no la mide ni puede medirla, porque el
                                                     reporte no trae marca de tiempo de origen: el instante del
                                                     evento fisico es un dato que no existe aqui, y llamarlo
                                                     latencia afirmaria un retardo total equivocado en dos ordenes
                                                     de magnitud. -->
                                                <TextBlock Text="ENTRE REPORTES" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                                                <TextBlock x:Name="MeasuredGapText" Text="--" Style="{StaticResource DataText}"
                                                           Foreground="{StaticResource TextLabelBrush}" FontSize="15"/>

                                                <!-- Requested drops to a secondary line. The dot compares the two: that
                                                     comparison is the whole product. -->
                                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                                    <TextBlock Text="PEDIDA" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Width="70"/>
                                                    <TextBlock Text="{Binding DisplayRate}" Style="{StaticResource DataText}" VerticalAlignment="Center"/>
                                                    <Ellipse x:Name="MeasuredDot" Style="{StaticResource StatusDot}" Margin="10,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock x:Name="MatchHintText" Text="" Style="{StaticResource FieldLabel}"
                                                           Foreground="{StaticResource StatusWarnBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Tarjeta ESPECIFICACIONES TECNICAS: la rejilla de cuatro filas de
                                             siempre, mas el instance id al final. -->
                                        <!-- Plegada por defecto. Estos cuatro campos son de diagnostico: hacen
                                             falta para entender por que una tasa no se aplico, no para el uso
                                             normal, y de partida empujaban CONFIGURACION DE TASA fuera de la
                                             vista. El ojo tachado dice que hay algo escondido; el ojo normal,
                                             que se esta viendo. La eleccion se recuerda entre sesiones: quien
                                             abre esto suele quererlo abierto siempre. -->
                                        <Grid Margin="0,16,0,8">
                                            <TextBlock Text="ESPECIFICACIONES TÉCNICAS" Style="{StaticResource SectionHeading}"
                                                       VerticalAlignment="Center"/>
                                            <Button x:Name="SpecsToggleBtn" Style="{StaticResource RoundIconButton}"
                                                    HorizontalAlignment="Right" Click="SpecsToggle_Click"
                                                    AutomationProperties.Name="Mostrar u ocultar las especificaciones tecnicas">
                                                <!-- Fill atado al Foreground del boton a mano: un Path NO hereda
                                                     Foreground, y sin esto el icono se queda del color por defecto
                                                     y no acompana al hover ni al atenuado. -->
                                                <Path x:Name="SpecsToggleIcon" Stretch="Uniform" Width="14" Height="14"
                                                      Data="{StaticResource EyeOffIconPath}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Button>
                                        </Grid>
                                        <Border x:Name="SpecsCard" Style="{StaticResource DeviceCard}" Visibility="Collapsed">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="26"/>
                                                        <RowDefinition Height="26"/>
                                                        <RowDefinition Height="26"/>
                                                        <RowDefinition Height="26"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="VELOCIDAD" Style="{StaticResource FieldLabel}"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SpeedText}" Style="{StaticResource DataText}"/>

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="bINTERVAL" Style="{StaticResource FieldLabel}"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BIntervalText}" Style="{StaticResource DataText}"/>

                                                    <!-- StatusDot is a whole-device fact (filter + speed + rate), so it is
                                                         anchored to FILTRO, the row it tracks most closely, not to
                                                         VELOCIDAD, which it does not describe. -->
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="FILTRO" Style="{StaticResource FieldLabel}"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FilterText}" Style="{StaticResource DataText}"/>
                                                    <Ellipse   Grid.Row="2" Grid.Column="2" Style="{StaticResource StatusDot}"
                                                               Fill="{Binding StatusDot, Converter={StaticResource StatusToBrush}}"/>

                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="INTERVALO" Style="{StaticResource FieldLabel}"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding IntervalModeText}" Style="{StaticResource DataText}"/>
                                                </Grid>

                                                <TextBlock Text="INSTANCE ID" Style="{StaticResource FieldLabel}" Margin="0,14,0,4"/>
                                                <!-- Es largo y no cabe: se recorta y el completo vive en el ToolTip.
                                                     Sirve para pegarlo en un reporte de fallo, asi que tiene que
                                                     poder leerse entero de algun modo. -->
                                                <TextBlock Text="{Binding InstanceId}" Style="{StaticResource DataText}" FontSize="11"
                                                           Foreground="{StaticResource TextLabelBrush}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding InstanceId}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Tarjeta CONFIGURACION DE TASA: el combo a lo ancho y los dos botones
                                             en fila, debajo. Los handlers no cambian. -->
                                        <TextBlock Text="CONFIGURACIÓN DE TASA" Style="{StaticResource SectionHeading}" Margin="0,16,0,8"/>
                                        <Border Style="{StaticResource DeviceCard}">
                                            <StackPanel>
                                                <ComboBox x:Name="DetailRateCombo"
                                                          FontFamily="{StaticResource MonoFont}"
                                                          SelectionChanged="DetailRateCombo_SelectionChanged"/>

                                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                    <Button x:Name="ApplyOverclockBtn" Content="APLICAR CAMBIOS"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Click="ApplyOverclock_Click"
                                                            ToolTip="Activa el filtro, escribe la tasa elegida y reconecta el dispositivo (los tres pasos encadenados). Es lo unico que aplica el overclock al 100%."/>

                                                    <Button x:Name="ResetOverclockBtn" Content="RESTABLECER VALORES"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Click="ResetOverclock_Click"
                                                            Margin="10,0,0,0"
                                                            ToolTip="Quita el filtro, borra la tasa guardada en el registro y reconecta: deja el dispositivo como estaba antes de tocarlo."/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- PAGE 1: SETTINGS / GLOBAL MODE -->
                        <TabItem Header="Settings">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="24" MaxWidth="620" HorizontalAlignment="Left">

                                    <!-- Estado del sistema. Vivia en la barra inferior, ocupando una franja
                                         permanente en TODAS las pantallas para repetir siempre lo mismo. Es
                                         estado fijo: su sitio es aqui, junto al servicio y al modo del driver
                                         que lo explican. -->
                                    <TextBlock Text="ESTADO DEL SISTEMA" Style="{StaticResource SectionHeading}"/>
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" Padding="18" Margin="0,8,0,20">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="PERMISOS" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Width="90"/>
                                                <TextBlock x:Name="PrivilegeText" Text="Administrador" Style="{StaticResource DataText}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <!-- Solo aparece cuando hay algo que advertir. El color lo pone
                                                 RefreshStatus segun DriverState, asi que sigue codificando un
                                                 hecho y no decorando. -->
                                            <TextBlock x:Name="WarningText" Text="" Style="{StaticResource DataText}"
                                                       FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"
                                                       Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="SERVICIO" Style="{StaticResource SectionHeading}"/>
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" Padding="18" Margin="0,8,0,20">
                                        <StackPanel>
                                            <!-- Moved here from the header, which is now the spectrum animation.
                                                 This is the only place the service state is reported, so it keeps
                                                 its status dot: the colour still encodes a real fact. -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                <TextBlock Text="ESTADO" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                                <Ellipse x:Name="ServiceStatusDot" Style="{StaticResource StatusDot}" Margin="10,0,6,0"/>
                                                <TextBlock x:Name="ServiceStatusText" Text="--" Style="{StaticResource DataText}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Driver hidusbf (lower filter). Requiere Administrador."
                                                       Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                <Button x:Name="InstallServiceBtn" Content="INSTALAR" Style="{StaticResource InstrumentButton}"
                                                        Click="InstallServiceBtn_Click" Margin="0,0,10,0"/>
                                                <Button x:Name="UninstallServiceBtn" Content="DESINSTALAR" Style="{StaticResource InstrumentButton}"
                                                        Click="UninstallServiceBtn_Click" Margin="0,0,10,0"/>
                                                <Button x:Name="RestartAllBtn" Content="REINICIAR FILTRADOS" Style="{StaticResource InstrumentButton}"
                                                        Click="RestartAllBtn_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="MODO DEL DRIVER" Style="{StaticResource SectionHeading}"/>
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" Padding="18" Margin="0,8,0,20">
                                        <StackPanel>
                                            <!-- The dot came with it from the header. Amber here means the driver
                                                 is capped at 1000 Hz - the single most useful thing this app knows,
                                                 and now the only place it is stated. -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="ACTIVO" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                                <Ellipse x:Name="HeaderModeDot" Style="{StaticResource StatusDot}" Margin="10,0,6,0"/>
                                                <TextBlock x:Name="DriverModeText" Text="--" Style="{StaticResource DataText}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="El modo lo fija PatchUSBXHCI en el registro, no el archivo .sys instalado."
                                                       Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                            <ComboBox x:Name="GlobalModeComboBox" Width="200" HorizontalAlignment="Left"
                                                      FontFamily="{StaticResource MonoFont}" Margin="0,12,0,0"
                                                      SelectionChanged="GlobalModeComboBox_SelectionChanged">
                                                <ComboBoxItem Content="NOPATCH"/>
                                                <ComboBoxItem Content="1kHz"/>
                                                <ComboBoxItem Content="2kHz-4kHz"/>
                                                <ComboBoxItem Content="4kHz-8kHz"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="LISTA" Style="{StaticResource SectionHeading}"/>
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" Padding="18" Margin="0,8,0,0">
                                        <StackPanel>
                                            <CheckBox x:Name="OnlyControllersCheck" Content="Solo controles y gamepads"
                                                      Foreground="{StaticResource TextDataBrush}" FontSize="12"
                                                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                                            <CheckBox x:Name="OnlyFilteredCheck" Content="Solo dispositivos con filtro"
                                                      Foreground="{StaticResource TextDataBrush}" FontSize="12" Margin="0,10,0,0"
                                                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="RECURSOS Y DRIVERS" Style="{StaticResource SectionHeading}" Margin="0,20,0,0"/>
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" Padding="18" Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Descarga de dependencias y drivers requeridos para las funciones de remapeo y overclock:" Style="{StaticResource FieldLabel}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                            
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Style="{StaticResource DataText}">
                                                    <Hyperlink NavigateUri="https://github.com/LordOfMice/hidusbf" RequestNavigate="Hyperlink_RequestNavigate">
                                                        Repositorio Oficial de hidusbf (SweetLow)
                                                    </Hyperlink>
                                                </TextBlock>
                                                <TextBlock Text="Controlador principal utilizado para el overclock del puerto USB y la tasa de sondeo." Style="{StaticResource FieldLabel}" Margin="16,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Style="{StaticResource DataText}">
                                                    <Hyperlink NavigateUri="https://github.com/nefarius/ViGEmBus/releases" RequestNavigate="Hyperlink_RequestNavigate">
                                                        Driver ViGEmBus (Nefarius)
                                                    </Hyperlink>
                                                </TextBlock>
                                                <TextBlock Text="Controlador del bus virtual requerido para emular el mando de PlayStation (DS4) o Xbox." Style="{StaticResource FieldLabel}" Margin="16,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Style="{StaticResource DataText}">
                                                    <Hyperlink NavigateUri="https://github.com/nefarius/HidHide/releases" RequestNavigate="Hyperlink_RequestNavigate">
                                                        Driver HidHide (Nefarius)
                                                    </Hyperlink>
                                                </TextBlock>
                                                <TextBlock Text="Filtro de dispositivo requerido para ocultar el mando físico y evitar la doble entrada de señal." Style="{StaticResource FieldLabel}" Margin="16,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <StackPanel>
                                                <TextBlock Style="{StaticResource DataText}">
                                                    <Hyperlink NavigateUri="https://dotnet.microsoft.com/download/dotnet/9.0" RequestNavigate="Hyperlink_RequestNavigate">
                                                        Microsoft .NET 9.0 Runtime
                                                    </Hyperlink>
                                                </TextBlock>
                                                <TextBlock Text="Entorno de ejecución de .NET requerido para el funcionamiento de la aplicación UltraPolling." Style="{StaticResource FieldLabel}" Margin="16,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Aviso anticheat (Task PS3): vivia arriba del todo en el configurador; se
                                         muda a Ajustes porque es informacion de riesgo, no un control que se
                                         consulte a cada rato. Texto sin cambios. -->
                                    <TextBlock Text="RIESGO Y ANTICHEAT" Style="{StaticResource SectionHeading}" Margin="0,20,0,0"/>
                                    <Border Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            Padding="14" Margin="0,8,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                                                   Text="El mando virtual (ViGEm) y HidHide son detectables por anticheat de nucleo (Ricochet, Vanguard, EAC, BattlEye) aunque no hagas trampa: algunos banean solo por la presencia de ViGEm. Ideal para un jugador o juegos sin anticheat; jugar online es bajo tu propio riesgo por el mecanismo, no por la intencion. Sin garantias, los baneos van por oleadas. No hay macros, emulacion de teclado o raton, ni auto-aim: esto solo reconfigura el mando."/>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- PAGE 2: CONTROLLER LIGHT -->
                        <TabItem Header="Light">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Sub-nav del hub "Mando": Configurar el mando (por defecto) | Luces del mando |
                                     Perfiles. PERFILES sube aqui, al mismo nivel que las otras dos, porque un
                                     perfil ya no pertenece a una de ellas: guarda las dos a la vez. -->
                                <Grid Grid.Row="0" Margin="24,16,24,0">
                                <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Icono + etiqueta corta. La etiqueta larga ("CONFIGURAR EL MANDO")
                                             repetia "EL MANDO" en dos de los tres segmentos cuando la seccion
                                             entera YA es el mando: el icono dice de que va y una palabra basta
                                             para distinguirlos.
                                             El Fill del icono se ata al Foreground del propio RadioButton: un
                                             Path NO hereda Foreground, y sin esto el icono se quedaria del
                                             color de las inactivas al activarse el segmento.
                                             AutomationProperties.Name porque el contenido ya no es una cadena.
                                             OJO: el segmento inicial NO se marca aqui. Un IsChecked="True" en
                                             XAML dispara Checked mientras se PARSEA, antes de que existan los
                                             paneles hermanos que el handler toca, y la app se cae al arrancar.
                                             Se marca en Window_Loaded, con el arbol ya entero. -->
                                        <RadioButton x:Name="ConfigTabBtn" GroupName="MandoNav" Checked="ShowConfigPanel"
                                                     Style="{StaticResource SegmentButton}"
                                                     AutomationProperties.Name="Configurar el mando"
                                                     ToolTip="Botones, sticks, gatillos y touchpad">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource GamepadIconPath}" Stretch="Uniform" Width="17" Height="17"
                                                      VerticalAlignment="Center" Margin="0,0,9,0"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                                <TextBlock Text="CONFIGURAR" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="LucesTabBtn" GroupName="MandoNav" Checked="ShowLucesPanel"
                                                     Style="{StaticResource SegmentButton}"
                                                     AutomationProperties.Name="Luces del mando"
                                                     ToolTip="Color de la barra y LED de jugador">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource BulbIconPath}" Stretch="Uniform" Width="17" Height="17"
                                                      VerticalAlignment="Center" Margin="0,0,9,0"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                                <TextBlock Text="LUCES" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>

                                <!-- PERFILES deja de ser una pagina y pasa a esta barra. Un perfil no es un
                                     sitio al que se va: es el estado en el que estas, asi que vive donde se
                                     ve siempre y se cambia sin salir de lo que estabas haciendo.
                                     BORRAR no cabe en cuatro botones, pero quitar la unica forma de borrar un
                                     perfil seria una perdida: vive en el menu contextual del desplegable. -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Path Data="{StaticResource ProfileIconPath}" Stretch="Uniform" Width="15" Height="15"
                                          VerticalAlignment="Center" Margin="0,0,9,0" Fill="{StaticResource TextLabelBrush}"/>

                                    <!-- El desplegable y el campo de renombrar ocupan la MISMA casilla y se
                                         turnan: renombrar pasa ahi mismo, sin abrir nada. -->
                                    <Grid VerticalAlignment="Center" Margin="0,0,12,0">
                                        <ComboBox x:Name="GameProfileCombo" Width="190"
                                                  SelectionChanged="GameProfileCombo_Changed"
                                                  ToolTip="Perfil activo. Elegir uno lo aplica."/>
                                        <!-- Un desplegable vacio no explica por que esta vacio. Este rotulo
                                             encima lo dice y senala al "+", que es por donde se empieza.
                                             IsHitTestVisible en falso: el clic tiene que llegar al
                                             desplegable de debajo, no morir en la etiqueta. -->
                                        <TextBlock x:Name="ProfileEmptyHint" Text="Sin perfiles todavia"
                                                   Style="{StaticResource FieldLabel}" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                                   IsHitTestVisible="False" Visibility="Collapsed"/>
                                        <TextBox x:Name="GameProfileRename" Width="190" Visibility="Collapsed"
                                                 Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextDataBrush}"
                                                 BorderBrush="{StaticResource TextDataBrush}" BorderThickness="1" Padding="6,4"
                                                 FontFamily="{StaticResource UiFont}"
                                                 KeyDown="GameProfileRename_KeyDown" LostFocus="GameProfileRename_Commit"/>
                                    </Grid>

                                    <!-- Sin etiquetas debajo: el ToolTip ya las dice y la fila ocupa la mitad.
                                         NUEVO y BORRAR son botones y no menus escondidos: crear otro perfil y
                                         deshacerse de uno son las dos preguntas que se hace cualquiera al ver
                                         un desplegable de perfiles, y una respuesta que hay que adivinar con el
                                         boton derecho no es una respuesta. -->
                                    <Button x:Name="ProfileNewBtn" Style="{StaticResource RoundIconButton}" Click="NewGameProfile_Click"
                                            Margin="0,0,6,0" ToolTip="Nuevo perfil con la configuracion de ahora">
                                        <TextBlock Text="+" FontSize="15" FontWeight="Bold" Margin="0,-2,0,0"
                                                   Foreground="{StaticResource TextDataBrush}"/>
                                    </Button>
                                    <Button x:Name="ProfileEditBtn" Style="{StaticResource RoundIconButton}" Click="ProfileEdit_Click"
                                            Margin="0,0,6,0" ToolTip="Renombrar el perfil elegido">
                                        <Path Data="{StaticResource PencilIconPath}" Stretch="Uniform" Width="13" Height="13"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                                    <Button x:Name="ProfileSaveBtn" Style="{StaticResource RoundIconButton}" Click="SaveGameProfile_Click"
                                            Margin="0,0,6,0" ToolTip="Guardar en este perfil la luz y la configuracion del mando de ahora">
                                        <Path Data="{StaticResource SaveIconPath}" Stretch="Uniform" Width="13" Height="13"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                                    <Button x:Name="ProfileDeleteBtn" Style="{StaticResource RoundIconButton}" Click="DeleteGameProfile_Click"
                                            Margin="0,0,14,0" ToolTip="Borrar el perfil elegido">
                                        <Path Data="{StaticResource TrashIconPath}" Stretch="Uniform" Width="13" Height="13"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                                    <Button x:Name="ProfileImportBtn" Style="{StaticResource RoundIconButton}" Click="ImportGameProfile_Click"
                                            Margin="0,0,6,0" ToolTip="Traer un perfil desde un archivo">
                                        <Path Data="{StaticResource ImportIconPath}" Stretch="Uniform" Width="13" Height="13"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                                    <Button x:Name="ProfileExportBtn" Style="{StaticResource RoundIconButton}" Click="ExportGameProfile_Click"
                                            ToolTip="Guardar el perfil elegido en un archivo para compartirlo">
                                        <Path Data="{StaticResource ExportIconPath}" Stretch="Uniform" Width="13" Height="13"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>
                                </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <!-- Configurador del mando: hub de tarjetas + sub-paginas (Task PS3),
                                         modelo "PlayStation Accessories". Ver ConfigPanel abajo. -->
                                    <Grid x:Name="ConfigPanel">
                                        <!-- Hub de tarjetas (Task PS3): antes esto era una columna larga con
                                             pestanas propias. Ahora es un hub (mando virtual + mando en vivo +
                                             4 tarjetas) mas 4 sub-paginas superpuestas, alternadas por
                                             visibilidad igual que el resto de la app; un unico sitio
                                             (UpdateConfigPages, code-behind) decide cual se ve. -->
                                        <Grid x:Name="ConfigHub">
                                            <Grid.RenderTransform>
                                                <TranslateTransform/>
                                            </Grid.RenderTransform>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel Margin="24">
                                                    <!-- Sin rotulo de pagina: el segmento de arriba ya dice CONFIGURAR y
                                                         repetirlo debajo era decir dos veces donde estas.

                                                         Interruptor maestro (Task 14). Apagado por defecto = mando NATIVO:
                                                         el juego ve el DualSense fisico y la app no toca nada. Encendido =
                                                         fisico oculto (HidHide) + DS4 virtual (ViGEm) con los ajustes de
                                                         abajo aplicados en vivo. El estado de al lado lee el driver real
                                                         (IsHiding/Connected), no una bandera. La explicacion larga que antes
                                                         vivia siempre visible ahora esta en el "?" (Task PS3): se consulta,
                                                         no se lee cada vez.

                                                         Padding 18 -> 14,10: la tarjeta guarda UNA fila, y el hueco de una
                                                         tarjeta con parrafos dentro la dejaba flotando en vacio. -->
                                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1" Padding="14,10" Margin="0,0,0,12">
                                                        <StackPanel>
                                                            <!-- Una sola fila: icono, titulo y el interruptor. Antes eran un rotulo,
                                                                 un boton con la frase entera dentro y una linea de estado debajo,
                                                                 para decir una cosa que es si o no. El interruptor lo dice de un
                                                                 vistazo y el "?" de al lado guarda la explicacion larga. -->
                                                            <Grid>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Path Data="{StaticResource GamepadIconPath}" Stretch="Uniform" Width="19" Height="19"
                                                                          VerticalAlignment="Center" Margin="0,0,11,0"
                                                                          Fill="{StaticResource TextDataBrush}"/>
                                                                    <TextBlock Text="MANDO VIRTUAL" Style="{StaticResource SectionHeading}"
                                                                               FontSize="13" VerticalAlignment="Center"/>
                                                                </StackPanel>

                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                    <!-- Anillo de espera del motor. Encender o apagar el mando virtual reinicia el
                                                                         devnode del DualSense y tarda varios segundos; hasta ahora la unica senal
                                                                         era el interruptor atenuado, que se lee como "deshabilitado", no como
                                                                         "trabajando". Es el MISMO anillo del escaneo, a escala de fila, para que
                                                                         la app tenga una sola forma de decir "espera" y no dos. -->
                                                                    <Canvas x:Name="EngineSpinner" Width="18" Height="18"
                                                                            VerticalAlignment="Center" Margin="0,0,10,0"
                                                                            Visibility="Collapsed">
                                                                        <Canvas.RenderTransform>
                                                                            <RotateTransform x:Name="EngineSpin" CenterX="9" CenterY="9"/>
                                                                        </Canvas.RenderTransform>
                                                                    </Canvas>
                                                                    <CheckBox x:Name="MasterToggleBtn" Style="{StaticResource SwitchToggle}"
                                                                              Margin="0,0,12,0" AutomationProperties.Name="Mando virtual"
                                                                              ToolTip="Enciende el mando virtual para que tus ajustes lleguen al juego"
                                                                              Checked="MasterToggle_Changed" Unchecked="MasterToggle_Changed"/>
                                                                    <Button x:Name="MasterHelpBtn" Style="{StaticResource RoundIconButton}"
                                                                            Click="MasterHelp_Click" ToolTip="Que hace esto">
                                                                        <TextBlock Text="?" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextDataBrush}"/>
                                                                    </Button>
                                                                </StackPanel>
                                                                <Popup x:Name="MasterHelpPopup" PlacementTarget="{Binding ElementName=MasterHelpBtn}"
                                                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None"
                                                                       Opened="AnimatePopupOpen">
                                                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                                            BorderThickness="1" Padding="14" MaxWidth="300">
                                                                        <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Foreground="{StaticResource TextDataBrush}"
                                                                                   Text="Activa el mando virtual para que los ajustes de abajo (sticks, gatillos, touchpad, botones) se apliquen al juego: el DualSense fisico se oculta y el juego ve un DS4 virtual con tu configuracion. Desactivalo para volver al mando nativo tal cual. Requiere los drivers ViGEmBus y HidHide (Nefarius), instalados aparte."/>
                                                                    </Border>
                                                                </Popup>
                                                            </Grid>
                                                            <!-- Vacio y sin ocupar sitio con el motor apagado: el interruptor de
                                                                 arriba ya dice si esta encendido, asi que una frase explicando que
                                                                 no lo esta es ruido. Reaparece cuando SI hay algo que contar:
                                                                 un error de arranque, un revert parcial o drivers ausentes. -->
                                                            <TextBlock x:Name="MasterStatusText" Style="{StaticResource DataText}" TextWrapping="Wrap"
                                                                       Margin="0,12,0,0" Text="" Visibility="Collapsed"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Mando en vivo (Task VZ3), ahora grande y protagonista del hub (Task PS3):
                                                         la salida TRANSFORMADA (post ajustes de abajo) del DualSense fisico, en
                                                         vivo a ~60fps. VisualizerFeed decide la fuente (lector propio con el motor
                                                         apagado, _padReader del motor cuando esta encendido). La tuerca agrupa lo
                                                         que antes eran controles sueltos (skin, calibracion, streamer). -->
                                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1" Padding="18" Margin="0,0,0,20">
                                                        <StackPanel>
                                                            <Grid>
                                                                <!-- Sin encabezado: un mando dibujado no necesita un cartel encima
                                                                     diciendo que es un mando. Lo que la frase larga explicaba (que se
                                                                     mueve con el motor apagado) se descubre moviendo el stick. -->

                                                                <Button x:Name="LiveGearBtn" Style="{StaticResource RoundIconButton}"
                                                                        HorizontalAlignment="Right" Click="LiveOptions_Click" ToolTip="Opciones del mando en vivo">
                                                                    <Path Data="{StaticResource SettingsIconPath}" Fill="{StaticResource TextLabelBrush}"
                                                                          Width="14" Height="14" Stretch="Uniform"/>
                                                                </Button>
                                                                <!-- HorizontalOffset negativo: la tuerca vive pegada al borde derecho del
                                                                     panel, asi que un popup anclado por su izquierda se salia de la ventana
                                                                     y cortaba los interruptores. -294 = ancho del panel (320) menos el de
                                                                     la tuerca (26), o sea alinear los dos bordes derechos.
                                                                     WPF solo voltea un popup solo cuando se sale de la PANTALLA, no de la
                                                                     ventana, asi que aqui no ayudaba. -->
                                                                <Popup x:Name="LiveOptionsPopup" PlacementTarget="{Binding ElementName=LiveGearBtn}"
                                                                       Placement="Bottom" HorizontalOffset="-294"
                                                                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="None"
                                                                       Opened="AnimatePopupOpen">
                                                                    <!-- Lista de opciones: una fila por modo, nombre a la izquierda e
                                                                         interruptor a la derecha. Cada uno de estos es un ESTADO
                                                                         (encendido/apagado), no una accion, y un interruptor lo dice de un
                                                                         vistazo: con los botones de antes habia que leer el texto para
                                                                         saber si el modo streamer estaba abierto o cerrado.
                                                                         RECARGAR SKIN se queda como boton porque no es un estado: es una
                                                                         accion que se dispara y termina. -->
                                                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                                            BorderThickness="1" CornerRadius="10" MinWidth="320">
                                                                        <StackPanel>
                                                                            <Border Style="{StaticResource OptionRow}">
                                                                                <Grid>
                                                                                    <TextBlock Text="Modo calibracion" Style="{StaticResource OptionRowLabel}"
                                                                                               ToolTip="Dibuja el recuadro de cada parte del skin sobre el mando"/>
                                                                                    <CheckBox x:Name="CalibrationCheck" Style="{StaticResource SwitchToggle}"
                                                                                              HorizontalAlignment="Right" AutomationProperties.Name="Modo calibracion"
                                                                                              Checked="Calibration_Changed" Unchecked="Calibration_Changed"/>
                                                                                </Grid>
                                                                            </Border>

                                                                            <!-- Modo streamer: overlay transparente para capturar por ventana, ver StreamerWindow. -->
                                                                            <Border Style="{StaticResource OptionRow}">
                                                                                <Grid>
                                                                                    <TextBlock Text="Modo streamer" Style="{StaticResource OptionRowLabel}"
                                                                                               ToolTip="Abre una ventana solo con el mando, transparente y siempre encima, para capturarla en OBS"/>
                                                                                    <CheckBox x:Name="StreamerToggle" Style="{StaticResource SwitchToggle}"
                                                                                              HorizontalAlignment="Right" AutomationProperties.Name="Modo streamer"
                                                                                              Checked="StreamerToggle_Changed" Unchecked="StreamerToggle_Changed"/>
                                                                                </Grid>
                                                                            </Border>

                                                                            <!-- Apaga el pasa-clic del overlay sin destruirlo: una vez ON desde la barra del
                                                                                 propio streamer, el raton lo atraviesa entero y su ToggleButton deja de ser
                                                                                 alcanzable, asi que esta ventana (nunca click-through) es el unico camino de
                                                                                 vuelta. Solo usable con el streamer abierto. -->
                                                                            <Border Style="{StaticResource OptionRow}">
                                                                                <Grid>
                                                                                    <TextBlock Text="Overlay atraviesa clic" Style="{StaticResource OptionRowLabel}"
                                                                                               ToolTip="El raton pasa a traves del overlay hasta el juego que hay debajo"/>
                                                                                    <CheckBox x:Name="StreamerClickThrough" Style="{StaticResource SwitchToggle}"
                                                                                              HorizontalAlignment="Right" IsEnabled="False"
                                                                                              AutomationProperties.Name="Overlay atraviesa clic"
                                                                                              Checked="StreamerClickThrough_Changed" Unchecked="StreamerClickThrough_Changed"/>
                                                                                </Grid>
                                                                            </Border>

                                                                            <!-- Ultima fila sin linea inferior, y una accion en vez de un interruptor.
                                                                                 Que skin se esta dibujando ya no ocupa una linea de texto: vive en
                                                                                 el ToolTip de este boton, que es justo donde se necesita saberlo. -->
                                                                            <Border Style="{StaticResource OptionRow}" BorderThickness="0">
                                                                                <Button x:Name="ReloadSkinBtn" Content="RECARGAR SKIN"
                                                                                        Style="{StaticResource InstrumentButton}"
                                                                                        HorizontalAlignment="Stretch" Click="ReloadSkin_Click"/>
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Popup>
                                                            </Grid>
                                                            <!-- Alto ACOTADO, no minimo: el Viewbox de dentro escala al ancho
                                                                 disponible, asi que un MinHeight sin techo hacia que a pantalla
                                                                 completa el mando midiera ~1700 px de ancho y enterrara las
                                                                 tarjetas del hub fuera de la vista. Con alto fijo el mando es el
                                                                 protagonista (antes 240) pero el hub entero sigue cabiendo. -->
                                                            <local:PadVisualHost x:Name="ConfigPadVisual" Height="300" Margin="0,10,0,0"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Las cuatro tarjetas del hub (Task PS3): icono + titulo + frase, modelo
                                                         "PlayStation Accessories". Cada Click entra a su sub-pagina via
                                                         GoToPage(); primero entender, luego ajustar. -->
                                                    <UniformGrid Columns="2" Margin="0,0,0,20">
                                                        <Button Style="{StaticResource HubCard}" Margin="0,0,6,6" Click="GoToBotones_Click">
                                                            <StackPanel>
                                                                <Path Data="{StaticResource GamepadIconPath}" Fill="{StaticResource TextDataBrush}"
                                                                      Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Left"/>
                                                                <TextBlock Text="ASIGNACION DE BOTONES" Style="{StaticResource SectionHeading}"
                                                                           Foreground="{StaticResource TextDataBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                                                                <TextBlock Text="Cambia lo que envia cada boton del mando." Style="{StaticResource FieldLabel}"
                                                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource HubCard}" Margin="6,0,0,6" Click="GoToSticks_Click">
                                                            <StackPanel>
                                                                <Path Data="{StaticResource StickIconPath}" Fill="{StaticResource TextDataBrush}"
                                                                      Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Left"/>
                                                                <TextBlock Text="SENSIBILIDAD Y ZONA MUERTA" Style="{StaticResource SectionHeading}"
                                                                           Foreground="{StaticResource TextDataBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                                                                <TextBlock Text="Ajusta la respuesta y la zona muerta de cada stick." Style="{StaticResource FieldLabel}"
                                                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource HubCard}" Margin="0,6,6,0" Click="GoToGatillos_Click">
                                                            <StackPanel>
                                                                <Path Data="{StaticResource TriggerIconPath}" Fill="{StaticResource TextDataBrush}"
                                                                      Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Left"/>
                                                                <TextBlock Text="RECORRIDO DE LOS GATILLOS" Style="{StaticResource SectionHeading}"
                                                                           Foreground="{StaticResource TextDataBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                                                                <TextBlock Text="El punto de disparo de L2 y R2." Style="{StaticResource FieldLabel}"
                                                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource HubCard}" Margin="6,6,0,0" Click="GoToTouchpad_Click">
                                                            <StackPanel>
                                                                <Path Data="{StaticResource TouchpadIconPath}" Fill="{StaticResource TextDataBrush}"
                                                                      Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Left"/>
                                                                <TextBlock Text="ZONAS DEL TOUCHPAD" Style="{StaticResource SectionHeading}"
                                                                           Foreground="{StaticResource TextDataBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                                                                <TextBlock Text="Que boton envia cada cuadrante del touchpad." Style="{StaticResource FieldLabel}"
                                                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </UniformGrid>

                                                    <!-- La barra "PERFILES DEL REMAPEO" que vivia aqui se retiro: los
                                                         perfiles son ahora una seccion propia (PerfilesPanel) que guarda
                                                         luz y mando juntos. RemapProfileStore sobrevive solo para el
                                                         pseudo-perfil "__ultimo_usado__", que es estado en vivo del
                                                         configurador, no un perfil del usuario. -->
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>

                                        <!-- ===== Sub-paginas (Task PS3): cada una es cabecera (atras + titulo + "?")
                                             + el contenido EXACTO que antes vivia en las pestanas propias del
                                             configurador (mismos x:Name, mismos handlers; el rediseno de cada
                                             una es tarea aparte). Overlaid sobre ConfigHub; UpdateConfigPages()
                                             decide cual se ve. ===== -->

                                        <Grid x:Name="PageBotones" Visibility="Collapsed">
                                            <Grid.RenderTransform>
                                                <TranslateTransform/>
                                            </Grid.RenderTransform>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Margin="24,20,24,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Style="{StaticResource RoundIconButton}" Click="ConfigBack_Click" ToolTip="Volver">
                                                    <TextBlock Text="&#8249;" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDataBrush}"/>
                                                </Button>
                                                <TextBlock Grid.Column="1" Text="Asignacion de botones" Style="{StaticResource SectionHeading}"
                                                           FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <!-- Dia/noche de ESTA pagina: la lamina del mando existe en dos versiones y esto
                                                         elige cual se dibuja. No es un tema para toda la app. -->
                                                    <!-- AutomationProperties.Name porque el control ya no lleva texto: sin el,
                                                         un lector de pantalla lo anuncia como "casilla" y nada mas. El ToolTip
                                                         es para quien ve; esto es para quien no. -->
                                                    <CheckBox x:Name="DiagramDayCheck" Style="{StaticResource DayNightToggle}"
                                                              VerticalAlignment="Center" Margin="0,0,14,0"
                                                              AutomationProperties.Name="Modo dia"
                                                              ToolTip="Dia o noche: cambia la lamina del mando de este diagrama"
                                                              Checked="DiagramDay_Changed" Unchecked="DiagramDay_Changed"/>
                                                    <Button x:Name="BotonesHelpBtn" Style="{StaticResource RoundIconButton}" Click="BotonesHelp_Click" ToolTip="Ayuda">
                                                        <TextBlock Text="?" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextDataBrush}"/>
                                                    </Button>
                                                </StackPanel>
                                                <Popup x:Name="BotonesHelpPopup" Grid.Column="2" PlacementTarget="{Binding ElementName=BotonesHelpBtn}"
                                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None"
                                                       Opened="AnimatePopupOpen">
                                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1" Padding="14" MaxWidth="280">
                                                        <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Foreground="{StaticResource TextDataBrush}"
                                                                   Text="Cada boton de origen envia el boton de destino elegido. Dejalo igual para no remapearlo."/>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel Margin="24">
                                                    <!-- El diagrama entero (imagen/respaldo vectorial + 16 lineas guia + 16
                                                         pildoras) se construye una sola vez en BuildButtonDiagram(): son 16
                                                         grupos y escribirlos a mano aqui seria ilegible y se desincronizaria
                                                         de la tabla de anclas de PadDiagram. El Viewbox escala el lienzo de
                                                         base fija (PadDiagram.CanvasWidth/Height, mas ancho que la imagen
                                                         para que quepan las columnas de etiquetas) sin deformarlo.
                                                         El fondo del panel lo pone BuildButtonDiagram: claro con la imagen
                                                         (line art invertido, tinta negra sobre papel blanco), oscuro con el
                                                         respaldo vectorial. Una sola bandera decide, para que no salga un
                                                         panel blanco con un mando pensado para fondo negro. -->
                                                    <Border x:Name="DiagramPanel" CornerRadius="12" Padding="12"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                        <Viewbox Stretch="Uniform" MaxHeight="700">
                                                            <Canvas x:Name="DiagramCanvas"/>
                                                        </Viewbox>
                                                    </Border>
                                                    <Button Content="RESTABLECER" Style="{StaticResource SecondaryButton}"
                                                            Click="ResetButtonRemap_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                                                </StackPanel>
                                            </ScrollViewer>

                                            <!-- Picker de destino (Step 5): un Popup unico reutilizado para las 16
                                                 pildoras (en vez de 16 popups o un archivo XAML aparte); ButtonPill_Click
                                                 lo ancla a la pildora pulsada y rellena su lista la primera vez. -->
                                            <Popup x:Name="ButtonPickerPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                                   PopupAnimation="None" Opened="AnimatePopupOpen">
                                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1" Padding="4" MinWidth="170" MaxHeight="360">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                        <StackPanel x:Name="ButtonPickerList"/>
                                                    </ScrollViewer>
                                                </Border>
                                            </Popup>
                                        </Grid>

                                        <Grid x:Name="PageSticks" Visibility="Collapsed">
                                            <Grid.RenderTransform>
                                                <TranslateTransform/>
                                            </Grid.RenderTransform>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Margin="24,20,24,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Style="{StaticResource RoundIconButton}" Click="ConfigBack_Click" ToolTip="Volver">
                                                    <TextBlock Text="&#8249;" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDataBrush}"/>
                                                </Button>
                                                <TextBlock Grid.Column="1" Text="Sensibilidad y zona muerta de los sticks" Style="{StaticResource SectionHeading}"
                                                           FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                <Button x:Name="SticksHelpBtn" Grid.Column="2" Style="{StaticResource RoundIconButton}" Click="SticksHelp_Click" ToolTip="Ayuda">
                                                    <TextBlock Text="?" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextDataBrush}"/>
                                                </Button>
                                                <Popup x:Name="SticksHelpPopup" Grid.Column="2" PlacementTarget="{Binding ElementName=SticksHelpBtn}"
                                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None"
                                                       Opened="AnimatePopupOpen">
                                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1" Padding="14" MaxWidth="280">
                                                        <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Foreground="{StaticResource TextDataBrush}"
                                                                   Text="Zona muerta, respuesta y curva por stick. El boton COMO FUNCIONA de abajo explica los tres puntos de la curva."/>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel Margin="24">
                                                    <Button x:Name="HelpToggleBtn" Content="¿CÓMO FUNCIONA?" Style="{StaticResource InstrumentButton}"
                                                            HorizontalAlignment="Left" Margin="0,0,0,12" Click="ToggleHelpPanel_Click"/>

                                                    <Border x:Name="HelpPanel" Visibility="Collapsed" Background="{StaticResource BgBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                                                            Padding="16" Margin="0,0,0,16">
                                                        <StackPanel>
                                                            <TextBlock Text="GUÍA DE CURVAS DE RESPUESTA" Style="{StaticResource SectionHeading}" Foreground="{StaticResource TextDataBrush}" Margin="0,0,0,12"/>
                                                            <TextBlock TextWrapping="Wrap" Style="{StaticResource FieldLabel}" Foreground="{StaticResource TextDataBrush}" Margin="0,0,0,8"
                                                                       Text="La curva de respuesta define cómo se traduce la inclinación física de tu stick (entrada) al movimiento en el juego (salida)."/>

                                                            <BulletDecorator Margin="0,4,0,4">
                                                                <BulletDecorator.Bullet>
                                                                    <Ellipse Width="8" Height="8" Fill="#66BB6A" Stroke="White" StrokeThickness="1" Margin="0,3,8,0"/>
                                                                </BulletDecorator.Bullet>
                                                                <TextBlock TextWrapping="Wrap" Style="{StaticResource FieldLabel}" Foreground="{StaticResource TextMutedBrush}"
                                                                           Text="Punto Verde (Zona Baja): Controla los pequeños movimientos. Ideal para micro-ajustes y precisión al apuntar a larga distancia. Bajarlo da más precisión."/>
                                                            </BulletDecorator>

                                                            <BulletDecorator Margin="0,4,0,4">
                                                                <BulletDecorator.Bullet>
                                                                    <Ellipse Width="8" Height="8" Fill="#FFCA28" Stroke="White" StrokeThickness="1" Margin="0,3,8,0"/>
                                                                </BulletDecorator.Bullet>
                                                                <TextBlock TextWrapping="Wrap" Style="{StaticResource FieldLabel}" Foreground="{StaticResource TextMutedBrush}"
                                                                           Text="Punto Ámbar (Zona Media): Transición suave entre precisión y giros rápidos. Define la progresividad general de la respuesta."/>
                                                            </BulletDecorator>

                                                            <BulletDecorator Margin="0,4,0,12">
                                                                <BulletDecorator.Bullet>
                                                                    <Ellipse Width="8" Height="8" Fill="#EF5350" Stroke="White" StrokeThickness="1" Margin="0,3,8,0"/>
                                                                </BulletDecorator.Bullet>
                                                                <TextBlock TextWrapping="Wrap" Style="{StaticResource FieldLabel}" Foreground="{StaticResource TextMutedBrush}"
                                                                           Text="Punto Rojo (Zona Alta): Controla la respuesta cerca del límite físico del stick. Subirlo garantiza que alcances la velocidad máxima de giro antes."/>
                                                            </BulletDecorator>

                                                            <TextBlock TextWrapping="Wrap" Style="{StaticResource FieldLabel}" Foreground="{StaticResource TextDataBrush}"
                                                                       Text="CONSEJO: En modo 'Lineal', la entrada equivale directamente a la salida. En modo 'Editor', arrastra los puntos con el ratón directamente en el gráfico para diseñar tu propia curva personalizada (por ejemplo, con una zona central plana para mejor precisión)."/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Los dos sticks lado a lado, mitad y mitad. En columna eran dos
                                                         bloques identicos de casi 400 px cada uno: para comparar la zona
                                                         muerta o la curva de uno con la del otro habia que recordar el
                                                         primero mientras se hacia scroll hasta el segundo. Puestos en
                                                         paralelo se ven a la vez, que es como se ajustan. -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="16"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1" CornerRadius="10" Padding="18">
                                                        <StackPanel>
                                                            <TextBlock Text="STICK IZQUIERDO" Style="{StaticResource SectionHeading}"/>

                                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                                <TextBlock Text="ZONA MUERTA" Style="{StaticResource FieldLabel}"
                                                                           VerticalAlignment="Center" Width="100"/>
                                                                <Slider x:Name="LeftDeadzoneSlider" Minimum="0" Maximum="30" Value="0" Width="160"
                                                                        IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                                                        ValueChanged="LeftDeadzone_Changed"/>
                                                                <TextBlock x:Name="LeftDeadzoneText" Text="0%" Style="{StaticResource DataText}"
                                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                            </StackPanel>

                                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                                <TextBlock Text="RESPUESTA" Style="{StaticResource FieldLabel}"
                                                                           VerticalAlignment="Center" Width="100"/>
                                                                <ComboBox x:Name="LeftCurveList" Width="190"
                                                                          SelectionChanged="LeftCurve_Changed"/>
                                                            </StackPanel>

                                                            <TextBlock Text="CURVA (entrada -&gt; salida)" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                                                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                                    BorderThickness="1" Width="220" Height="100" HorizontalAlignment="Left">
                                                                <Canvas x:Name="LeftCurveCanvas" Width="220" Height="100" ClipToBounds="True"
                                                                        Background="Transparent"
                                                                        MouseLeftButtonDown="LeftCurveCanvas_MouseDown"
                                                                        MouseMove="LeftCurveCanvas_MouseMove"
                                                                        MouseLeftButtonUp="LeftCurveCanvas_MouseUp">
                                                                    <Line x:Name="LeftCurveRef" X1="0" Y1="100" X2="220" Y2="0"
                                                                          Stroke="{StaticResource BorderBrush}" StrokeThickness="1" StrokeDashArray="3 3" Opacity="0.5"/>
                                                                    <Polyline x:Name="LeftCurveLine" Stroke="{StaticResource TextDataBrush}" StrokeThickness="1.5"/>
                                                                    <Ellipse x:Name="LeftCurveLiveDot" Width="7" Height="7" Fill="White" Visibility="Collapsed"/>
                                                                </Canvas>
                                                            </Border>
                                                            <TextBlock x:Name="LeftCurveLiveLabel" Style="{StaticResource FieldLabel}"
                                                                       FontFamily="{StaticResource MonoFont}" Margin="0,6,0,0" Visibility="Collapsed"/>

                                                            <TextBlock Text="MIS CURVAS" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                                                            <StackPanel Orientation="Horizontal">
                                                                <ComboBox x:Name="LeftSavedCurveList" Width="140" DisplayMemberPath="Name" Margin="0,0,8,0"/>
                                                                <Button Content="CARGAR" Style="{StaticResource InstrumentButton}" Click="LoadLeftCurve_Click" Margin="0,0,8,0"/>
                                                                <Button Content="BORRAR" Style="{StaticResource InstrumentButton}" Click="DeleteLeftCurve_Click"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                                <TextBox x:Name="LeftCurveName" Width="140" Background="{StaticResource SurfaceAltBrush}"
                                                                         Foreground="{StaticResource TextDataBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                                         BorderThickness="1" Padding="6,4" FontFamily="{StaticResource UiFont}" Margin="0,0,8,0"/>
                                                                <Button Content="GUARDAR CURVA" Style="{StaticResource InstrumentButton}" Click="SaveLeftCurve_Click"/>
                                                            </StackPanel>

                                                            <Button x:Name="LeftAdvancedToggle" Content="AVANZADO" Style="{StaticResource InstrumentButton}"
                                                                    HorizontalAlignment="Left" Margin="0,14,0,0" Click="ToggleLeftAdvanced"/>
                                                            <StackPanel x:Name="LeftAdvancedPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="ALCANCE" Style="{StaticResource FieldLabel}"
                                                                               VerticalAlignment="Center" Width="100"/>
                                                                    <Slider x:Name="LeftReachSlider" Minimum="70" Maximum="100" Value="100" Width="160"
                                                                            IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                                                            ValueChanged="LeftReach_Changed"/>
                                                                    <TextBlock x:Name="LeftReachText" Text="100%" Style="{StaticResource DataText}"
                                                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1" CornerRadius="10" Padding="18">
                                                        <StackPanel>
                                                            <TextBlock Text="STICK DERECHO" Style="{StaticResource SectionHeading}"/>

                                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                                <TextBlock Text="ZONA MUERTA" Style="{StaticResource FieldLabel}"
                                                                           VerticalAlignment="Center" Width="100"/>
                                                                <Slider x:Name="RightDeadzoneSlider" Minimum="0" Maximum="30" Value="0" Width="160"
                                                                        IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                                                        ValueChanged="RightDeadzone_Changed"/>
                                                                <TextBlock x:Name="RightDeadzoneText" Text="0%" Style="{StaticResource DataText}"
                                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                            </StackPanel>

                                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                                <TextBlock Text="RESPUESTA" Style="{StaticResource FieldLabel}"
                                                                           VerticalAlignment="Center" Width="100"/>
                                                                <ComboBox x:Name="RightCurveList" Width="190"
                                                                          SelectionChanged="RightCurve_Changed"/>
                                                            </StackPanel>

                                                            <TextBlock Text="CURVA (entrada -&gt; salida)" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                                                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                                    BorderThickness="1" Width="220" Height="100" HorizontalAlignment="Left">
                                                                <Canvas x:Name="RightCurveCanvas" Width="220" Height="100" ClipToBounds="True"
                                                                        Background="Transparent"
                                                                        MouseLeftButtonDown="RightCurveCanvas_MouseDown"
                                                                        MouseMove="RightCurveCanvas_MouseMove"
                                                                        MouseLeftButtonUp="RightCurveCanvas_MouseUp">
                                                                    <Line x:Name="RightCurveRef" X1="0" Y1="100" X2="220" Y2="0"
                                                                          Stroke="{StaticResource BorderBrush}" StrokeThickness="1" StrokeDashArray="3 3" Opacity="0.5"/>
                                                                    <Polyline x:Name="RightCurveLine" Stroke="{StaticResource TextDataBrush}" StrokeThickness="1.5"/>
                                                                    <Ellipse x:Name="RightCurveLiveDot" Width="7" Height="7" Fill="White" Visibility="Collapsed"/>
                                                                </Canvas>
                                                            </Border>
                                                            <TextBlock x:Name="RightCurveLiveLabel" Style="{StaticResource FieldLabel}"
                                                                       FontFamily="{StaticResource MonoFont}" Margin="0,6,0,0" Visibility="Collapsed"/>

                                                            <TextBlock Text="MIS CURVAS" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                                                            <StackPanel Orientation="Horizontal">
                                                                <ComboBox x:Name="RightSavedCurveList" Width="140" DisplayMemberPath="Name" Margin="0,0,8,0"/>
                                                                <Button Content="CARGAR" Style="{StaticResource InstrumentButton}" Click="LoadRightCurve_Click" Margin="0,0,8,0"/>
                                                                <Button Content="BORRAR" Style="{StaticResource InstrumentButton}" Click="DeleteRightCurve_Click"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                                <TextBox x:Name="RightCurveName" Width="140" Background="{StaticResource SurfaceAltBrush}"
                                                                         Foreground="{StaticResource TextDataBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                                         BorderThickness="1" Padding="6,4" FontFamily="{StaticResource UiFont}" Margin="0,0,8,0"/>
                                                                <Button Content="GUARDAR CURVA" Style="{StaticResource InstrumentButton}" Click="SaveRightCurve_Click"/>
                                                            </StackPanel>

                                                            <Button x:Name="RightAdvancedToggle" Content="AVANZADO" Style="{StaticResource InstrumentButton}"
                                                                    HorizontalAlignment="Left" Margin="0,14,0,0" Click="ToggleRightAdvanced"/>
                                                            <StackPanel x:Name="RightAdvancedPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="ALCANCE" Style="{StaticResource FieldLabel}"
                                                                               VerticalAlignment="Center" Width="100"/>
                                                                    <Slider x:Name="RightReachSlider" Minimum="70" Maximum="100" Value="100" Width="160"
                                                                            IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                                                            ValueChanged="RightReach_Changed"/>
                                                                    <TextBlock x:Name="RightReachText" Text="100%" Style="{StaticResource DataText}"
                                                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>

                                        <Grid x:Name="PageGatillos" Visibility="Collapsed">
                                            <Grid.RenderTransform>
                                                <TranslateTransform/>
                                            </Grid.RenderTransform>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Margin="24,20,24,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Style="{StaticResource RoundIconButton}" Click="ConfigBack_Click" ToolTip="Volver">
                                                    <TextBlock Text="&#8249;" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDataBrush}"/>
                                                </Button>
                                                <TextBlock Grid.Column="1" Text="Recorrido de los gatillos" Style="{StaticResource SectionHeading}"
                                                           FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                <Button x:Name="GatillosHelpBtn" Grid.Column="2" Style="{StaticResource RoundIconButton}" Click="GatillosHelp_Click" ToolTip="Ayuda">
                                                    <TextBlock Text="?" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextDataBrush}"/>
                                                </Button>
                                                <Popup x:Name="GatillosHelpPopup" Grid.Column="2" PlacementTarget="{Binding ElementName=GatillosHelpBtn}"
                                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None"
                                                       Opened="AnimatePopupOpen">
                                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1" Padding="14" MaxWidth="280">
                                                        <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Foreground="{StaticResource TextDataBrush}"
                                                                   Text="Hair trigger por gatillo: por debajo del punto no se activa; en el punto o mas, se activa a fondo de inmediato."/>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <!-- Un cuadro por gatillo, con su arco DENTRO. Antes la lamina iba en una
                                                     tira aparte y los dos arcos flotaban encima intentando cuadrar con un
                                                     dibujo que no controlaban: el izquierdo caia sobre las dos formas y el
                                                     derecho en el vacio. Metiendo cada arco en la tarjeta de su gatillo,
                                                     cada uno se centra sobre lo suyo y no hay nada que calibrar entre
                                                     imagen y arco.
                                                     Cada arco dice DOS cosas: los guiones encendidos son el recorrido real
                                                     del gatillo ahora mismo, y el guion largo es el punto de disparo
                                                     configurado - se ajusta apretando y comprobando. -->
                                                <Grid Margin="24">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            CornerRadius="10" Padding="18">
                                                        <StackPanel>
                                                            <TextBlock Text="L2 - PUNTO DE DISPARO" Style="{StaticResource SectionHeading}"/>
                                                            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                                       Text="Hair trigger: por debajo del punto no se activa; en el punto o mas, se activa a fondo de inmediato. En 0% el gatillo queda progresivo, sin efecto."/>
                                                            <!-- Viewbox: el arco mide 240 px fijos y la tarjeta es elastica, asi
                                                                 que en ventana pequena se salia por el borde. Asi se encoge
                                                                 manteniendo la proporcion en vez de recortarse. -->
                                                            <Viewbox MaxHeight="240" Margin="0,14,0,14" Stretch="Uniform"
                                                                     HorizontalAlignment="Center">
                                                                <Grid>
                                                                    <Image x:Name="L2Artwork" Stretch="Uniform" Visibility="Collapsed"/>
                                                                    <local:TriggerArc x:Name="L2Arc"/>
                                                                </Grid>
                                                            </Viewbox>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Slider x:Name="L2PointSlider" Minimum="0" Maximum="100" Value="0" Width="220"
                                                                        IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                                                        ValueChanged="L2Point_Changed"/>
                                                                <TextBlock x:Name="L2PointText" Text="0%" Style="{StaticResource DataText}"
                                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                            </StackPanel>
                                                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                                    BorderThickness="1" Height="10" Width="220" HorizontalAlignment="Left" Margin="0,10,0,0">
                                                                <Rectangle x:Name="L2PointBar" Fill="{StaticResource TextDataBrush}"
                                                                           HorizontalAlignment="Left" Width="0"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                            CornerRadius="10" Padding="18">
                                                        <StackPanel>
                                                            <TextBlock Text="R2 - PUNTO DE DISPARO" Style="{StaticResource SectionHeading}"/>
                                                            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                                       Text="Mismo hair trigger que L2, para el gatillo derecho."/>
                                                            <Viewbox MaxHeight="240" Margin="0,14,0,14" Stretch="Uniform"
                                                                     HorizontalAlignment="Center">
                                                                <Grid>
                                                                    <Image x:Name="R2Artwork" Stretch="Uniform" Visibility="Collapsed"/>
                                                                    <local:TriggerArc x:Name="R2Arc" Mirrored="True"/>
                                                                </Grid>
                                                            </Viewbox>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Slider x:Name="R2PointSlider" Minimum="0" Maximum="100" Value="0" Width="220"
                                                                        IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                                                        ValueChanged="R2Point_Changed"/>
                                                                <TextBlock x:Name="R2PointText" Text="0%" Style="{StaticResource DataText}"
                                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                            </StackPanel>
                                                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                                    BorderThickness="1" Height="10" Width="220" HorizontalAlignment="Left" Margin="0,10,0,0">
                                                                <Rectangle x:Name="R2PointBar" Fill="{StaticResource TextDataBrush}"
                                                                           HorizontalAlignment="Left" Width="0"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </ScrollViewer>
                                        </Grid>

                                        <Grid x:Name="PageTouchpad" Visibility="Collapsed">
                                            <Grid.RenderTransform>
                                                <TranslateTransform/>
                                            </Grid.RenderTransform>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Margin="24,20,24,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Style="{StaticResource RoundIconButton}" Click="ConfigBack_Click" ToolTip="Volver">
                                                    <TextBlock Text="&#8249;" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDataBrush}"/>
                                                </Button>
                                                <TextBlock Grid.Column="1" Text="Zonas del touchpad" Style="{StaticResource SectionHeading}"
                                                           FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                <Button x:Name="TouchpadHelpBtn" Grid.Column="2" Style="{StaticResource RoundIconButton}" Click="TouchpadHelp_Click" ToolTip="Ayuda">
                                                    <TextBlock Text="?" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextDataBrush}"/>
                                                </Button>
                                                <Popup x:Name="TouchpadHelpPopup" Grid.Column="2" PlacementTarget="{Binding ElementName=TouchpadHelpBtn}"
                                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None"
                                                       Opened="AnimatePopupOpen">
                                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1" Padding="14" MaxWidth="280">
                                                        <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Foreground="{StaticResource TextDataBrush}"
                                                                   Text="Un toque en cada cuadrante del touchpad puede enviar un boton. Ninguno lo deja sin efecto."/>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel Margin="24">
                                                    <TextBlock Text="ZONAS DEL TOUCHPAD" Style="{StaticResource SectionHeading}"/>
                                                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,6,0,12"
                                                               Text="Un toque en cada cuadrante del touchpad puede enviar un boton. Ninguno lo deja sin efecto."/>
                                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1" Padding="18">
                                                        <Grid x:Name="TouchZoneGrid">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition/>
                                                                <RowDefinition/>
                                                            </Grid.RowDefinitions>
                                                            <!-- Las 4 celdas (label + ComboBox por zona) las llena BuildTouchZoneCombos(). -->
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                    </Grid>

                                    <Grid x:Name="LucesPanel" Visibility="Collapsed">
                                    <!-- Two columns AND a scroller. The columns are what make it fit; the
                                         scroller is the net. Without one, this page has already dropped
                                         RESTAURAR and the anti-cheat warning off the bottom twice - once
                                         as a single column, and again the moment the EFECTO card grew two
                                         rows. Content that overflows must be reachable, not gone. -->
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <Grid Margin="24">
                                        <!-- Empty state. A page of dead sliders would imply the feature is broken
                                             rather than inapplicable. -->
                                        <StackPanel x:Name="LightEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="Sin mandos de PlayStation conectados" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Esta funcion solo aplica a DualSense y DualShock." Style="{StaticResource FieldLabel}"
                                               Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>

                                <!-- Two columns. As one narrow column this page ran off the bottom of the
                                     window with no ScrollViewer, so PERFILES, RESTAURAR and the anti-cheat
                                     warning were unreachable - while half the window sat empty. Colour on
                                     the left, everything that acts on it on the right. -->
                                <Grid x:Name="LightPanel">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>  <!-- fila vacia: se deja para no correr los indices de las de abajo -->
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- colour: sized by the picker -->
                                        <ColumnDefinition Width="*"/>    <!-- controls -->
                                    </Grid.ColumnDefinitions>

                                    <StackPanel x:Name="ColorSection" Grid.Row="1" Grid.Column="0" Margin="0,0,20,0">
                                    <TextBlock Text="COLOR" Style="{StaticResource SectionHeading}"/>
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" Padding="18" Margin="0,8,0,0">
                                        <StackPanel>
                                            <!-- Presets first: nobody arrives wanting a specific hex, they arrive
                                                 wanting "blue". Built in code so each swatch carries its RGB. -->
                                            <StackPanel x:Name="PresetRow" Orientation="Horizontal" Margin="0,0,0,16"/>

                                            <!-- Debajo de los presets de fabrica: la paleta del usuario,
                                                 sus colores guardados mas el "+" que anade el actual. -->
                                            <TextBlock Text="MI PALETA" Style="{StaticResource FieldLabel}" Margin="0,4,0,8"/>
                                            <StackPanel x:Name="PaletteRow" Orientation="Horizontal" Margin="0,0,0,16"/>

                                            <!-- El propio ColourPicker trae ya su banda de vista previa y su
                                                 campo hex editable: la muestra y el texto sueltos que habia
                                                 aqui antes duplicaban el color y el hex por partida doble. -->
                                            <local:ColourPicker x:Name="Picker"
                                                                 ColorChanged="Picker_ColorChanged" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>
                                    </StackPanel>

                                    <!-- Right column: everything that acts on the colour. -->
                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,8,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                <Path Data="{StaticResource ProfileIconPath}" Stretch="Uniform" Width="16" Height="16"
                                                      VerticalAlignment="Center" Margin="0,0,10,0" Fill="{StaticResource TextDataBrush}"/>
                                                <TextBlock Text="LUCES DE JUGADOR" Style="{StaticResource SectionHeading}"
                                                           FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Jugador y brillo, construidos en code-behind: son seis y tres segmentos que
                                                 cargan cada uno su valor del enum, y escribirlos a mano aqui invitaria a que
                                                 la lista y el enum se separasen. -->
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel x:Name="PlayerLedRow" Orientation="Horizontal" VerticalAlignment="Center"/>
                                                <Border Width="1" Background="{StaticResource BorderBrush}" Margin="10,2,16,2"/>
                                                <TextBlock Text="BRILLO" Style="{StaticResource FieldLabel}"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <StackPanel x:Name="BrightnessRow" Orientation="Horizontal" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,12,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                                <Path Data="{StaticResource StarIconPath}" Stretch="Uniform" Width="16" Height="16"
                                                      VerticalAlignment="Center" Margin="0,0,10,0" Fill="{StaticResource TextDataBrush}"/>
                                                <!-- "DE LOS LED", no "PRINCIPAL": mas abajo hay otra tarjeta de efecto, la del
                                                     COLOR. Dos rotulos casi iguales gobernando cosas distintas confunden mas
                                                     que un rotulo largo. -->
                                                <TextBlock Text="EFECTO DE LOS LED" Style="{StaticResource SectionHeading}"
                                                           FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                <ComboBox x:Name="PlayerEffectList" Width="150" VerticalAlignment="Center"
                                                          SelectionChanged="PlayerEffect_Changed"/>
                                                <!-- Velocimetro, igual que en la fila del efecto de color. Antes aqui habia
                                                     un reloj, y ese mismo reloj marcaba abajo la DURACION de la vuelta: el
                                                     mismo icono queria decir dos cosas en la misma pantalla. -->
                                                <Path Data="{StaticResource SpeedIconPath}" Stretch="Uniform" Width="15" Height="15"
                                                      VerticalAlignment="Center" Margin="18,0,10,0" Fill="{StaticResource TextLabelBrush}"
                                                      ToolTip="Velocidad del efecto"/>
                                                <Slider x:Name="PlayerSpeed" Minimum="2" Maximum="20" Value="6" Width="140"
                                                        IsSnapToTickEnabled="True" TickFrequency="1"
                                                        VerticalAlignment="Center" ValueChanged="PlayerSpeed_Changed"
                                                        AutomationProperties.Name="Velocidad del efecto de los LED"/>
                                                <TextBlock x:Name="PlayerSpeedText" Text="" Style="{StaticResource DataText}"
                                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Misma tarjeta que LUCES DE JUGADOR y EFECTO DE LOS LED: mismo borde
                                         redondeado, mismo relleno, y el encabezado DENTRO con su icono. Antes
                                         el rotulo colgaba fuera y sin icono, y esta tercera tarjeta parecia de
                                         otra clase que sus dos vecinas. -->
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,10,0,0">
                                      <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <Path Data="{StaticResource PaletteIconPath}" Stretch="Uniform" Width="16" Height="16"
                                                  VerticalAlignment="Center" Margin="0,0,10,0" Fill="{StaticResource TextDataBrush}"/>
                                            <TextBlock Text="EFECTO DEL COLOR" Style="{StaticResource SectionHeading}"
                                                       FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Una sola fila de iconos. Antes eran una fila de controles mas DOS
                                             parrafos de ayuda que se leian una vez y estorbaban siempre; ahora
                                             cada explicacion vive en el ToolTip del control que describe, que
                                             es donde se busca cuando de verdad hace falta. -->
                                        <StackPanel Orientation="Horizontal">
                                            <!-- La casilla no lleva la palabra "Rainbow": lleva el degradado, que
                                                 dice lo mismo y ademas ENSENA lo que va a hacer el mando. -->
                                            <CheckBox x:Name="RainbowCheck" VerticalAlignment="Center" Margin="0,0,14,0"
                                                      AutomationProperties.Name="Efecto arcoiris"
                                                      ToolTip="Anima el color del mando. Lo mueve UltraPolling: al salir, el mando se queda en el ultimo color que recibio."
                                                      Checked="Rainbow_Toggled" Unchecked="Rainbow_Toggled">
                                                <Border Width="18" Height="18" CornerRadius="4"
                                                        Background="{StaticResource RainbowSwatchBrush}"/>
                                            </CheckBox>

                                            <!-- El ToolTip lo reescribe RainbowStyle_Changed con la explicacion del
                                                 estilo elegido; antes eso era un parrafo fijo bajo la fila. -->
                                            <ComboBox x:Name="RainbowStyleList" Width="118" VerticalAlignment="Center"
                                                      SelectionChanged="RainbowStyle_Changed"/>

                                            <!-- Mismo velocimetro y mismos margenes que la fila del EFECTO DE LOS
                                                 LED: las dos filas gobiernan lo mismo -la velocidad de un efecto-
                                                 y ahora se leen igual. Fuera el separador y el reloj: el reloj
                                                 marcaba aqui una DURACION mientras arriba marcaba una velocidad. -->
                                            <Path Data="{StaticResource SpeedIconPath}" Stretch="Uniform" Width="15" Height="15"
                                                  Fill="{StaticResource TextLabelBrush}" VerticalAlignment="Center"
                                                  Margin="18,0,10,0" ToolTip="Velocidad del efecto"/>
                                            <!-- Whole timer ticks per colour, reversed so right = faster. The
                                                 timer only honours multiples of 15.625ms (measured), so a
                                                 continuous speed slider would promise rates it cannot keep:
                                                 the old 30/s default really ran at 21.4/s. Every stop here is
                                                 a rate the timer actually delivers. -->
                                            <Slider x:Name="RainbowSpeed" Minimum="5" Maximum="360" Value="64" Width="140"
                                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                                    VerticalAlignment="Center" ValueChanged="RainbowSpeed_Changed"
                                                    AutomationProperties.Name="Velocidad del efecto de color"/>
                                            <!-- De las tres cifras que habia -colores/s, vuelta, y si se ve cada
                                                 color- se queda la vuelta, que es la unica que se siente mirando
                                                 el mando. Las otras dos no se pierden: van al ToolTip. -->
                                            <TextBlock x:Name="RainbowSpeedText" Text="" Style="{StaticResource DataText}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="46"/>
                                        </StackPanel>
                                      </StackPanel>
                                    </Border>

                                    <!-- La seccion PERFILES que vivia aqui subio a ser hermana de esta pagina
                                         (PerfilesPanel): un perfil guarda la luz Y la configuracion del mando,
                                         asi que no puede colgar de una sola de las dos. -->

                                    <!-- The controller cannot return to its default without being reconnected, so
                                         this is the only way back for someone who turned the light off.
                                         Boton de icono: la flecha circular es "devolver a como estaba". Sin
                                         etiqueta se parece a un "recargar", asi que el ToolTip dice exactamente
                                         a que color vuelve - no es opcional aqui, es lo que lo desambigua. -->
                                    <Button Style="{StaticResource RoundIconButton}"
                                            HorizontalAlignment="Left" Margin="0,20,0,0"
                                            Click="RestoreLight_Click"
                                            AutomationProperties.Name="Restaurar la luz por defecto"
                                            ToolTip="Restaurar: azul y Player 1, lo que Windows le pone por defecto. El mando no puede volver solo.">
                                        <Path Data="{StaticResource RefreshIconPath}" Stretch="Uniform" Width="14" Height="14"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Button>

                                    <!-- Aqui vivia un aviso en ambar que decia que cambiar el color era arriesgado
                                         para jugar online y que habia que cerrar la app antes de una partida.
                                         Quitado a peticion del usuario, y ademas era falso por partida doble:
                                         Apply() abre el mando en modo COMPARTIDO y escribe un report 0x02
                                         estandar tocando solo los bytes del LED - exactamente lo que hacen Steam
                                         Input y DSX en cada cuadro -, y desde que la app vive en la bandeja,
                                         "cierrala antes de jugar" contradecia a la propia app.
                                         El riesgo real de un anticheat esta en el MODO DE PARCHEO DEL DRIVER,
                                         que reescribe USBXHCI/USBPORT en memoria del kernel y sigue activo corra
                                         o no esta ventana. Ese aviso pertenece al selector de modo, no aqui. -->
                                    </StackPanel>
                                </Grid>
                            </Grid>
                            </ScrollViewer>
                                    </Grid>

                                    <!-- Aqui vivia PERFILES como pagina propia. Ya no: un perfil no es un
                                         sitio al que se va, es el estado en el que estas, asi que se maneja
                                         desde la barra de arriba sin salir de lo que estabas haciendo. -->
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <!-- Barra MUDA. Solo aparece cuando hay algo pasajero que decir (un perfil
                         guardado, una tasa escrita, un error) y se retira sola: ocupar una franja
                         permanente en todas las pantallas para repetir lo mismo era ruido.
                         Lo que era fijo -el aviso del driver y ADMIN- vive ahora en Ajustes, que
                         es donde se va a mirar el estado del sistema. -->
                    <Border x:Name="StatusBar" Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Height="30"
                            Visibility="Collapsed">
                        <Grid Margin="16,0">
                            <TextBlock x:Name="StatusLogText" Text="" Style="{StaticResource DataText}"
                                       FontSize="11" Foreground="{StaticResource TextLabelBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
