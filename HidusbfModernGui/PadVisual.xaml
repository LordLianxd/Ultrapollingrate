<UserControl x:Class="HidusbfModernGui.PadVisual"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- RootSurface: Background alterna entre transparente (overlay de streaming) y
         SurfaceBrush (dentro de la ventana normal) via StreamerBackground en el
         code-behind. El Viewbox interior escala el Canvas de base fija sin deformar. -->
    <Border x:Name="RootSurface" Background="{StaticResource SurfaceBrush}">
        <Viewbox Stretch="Uniform">
            <Canvas Width="360" Height="260">

                <!-- Cuerpo del mando: un unico rectangulo redondeado que aloja todo lo
                     demas. No es un Path fiel a la silueta de un DualSense; el criterio
                     de aceptacion es "se reconoce como", no "es identico a". -->
                <Rectangle x:Name="PadBody" Canvas.Left="10" Canvas.Top="45" Width="340" Height="180"
                           RadiusX="46" RadiusY="46"
                           Fill="{StaticResource SurfaceBrush}"
                           Stroke="{StaticResource BorderBrush}" StrokeThickness="1.5"/>

                <!-- Gatillos L2/R2: marco fijo + barra de relleno. El code-behind solo
                     toca Height (0..TriggerMaxHeight); el Top se queda arriba del marco,
                     de forma que crecer hacia abajo se lee como "llenar" el marco. -->
                <Rectangle Canvas.Left="25" Canvas.Top="5" Width="28" Height="30"
                           Fill="{StaticResource SurfaceAltBrush}"
                           Stroke="{StaticResource BorderBrush}" StrokeThickness="1"/>
                <Rectangle x:Name="L2Fill" Canvas.Left="25" Canvas.Top="5" Width="28" Height="0"
                           Fill="{StaticResource TextDataBrush}"/>
                <TextBlock Text="L2" Canvas.Left="28" Canvas.Top="38" FontSize="9"
                           Foreground="{StaticResource TextLabelBrush}" IsHitTestVisible="False"/>

                <Rectangle Canvas.Left="307" Canvas.Top="5" Width="28" Height="30"
                           Fill="{StaticResource SurfaceAltBrush}"
                           Stroke="{StaticResource BorderBrush}" StrokeThickness="1"/>
                <Rectangle x:Name="R2Fill" Canvas.Left="307" Canvas.Top="5" Width="28" Height="0"
                           Fill="{StaticResource TextDataBrush}"/>
                <TextBlock Text="R2" Canvas.Left="309" Canvas.Top="38" FontSize="9"
                           Foreground="{StaticResource TextLabelBrush}" IsHitTestVisible="False"/>

                <!-- Hombros L1/R1. -->
                <Rectangle x:Name="BtnL1" Canvas.Left="20" Canvas.Top="38" Width="55" Height="14"
                           RadiusX="4" RadiusY="4" Fill="#3A3A3A"/>
                <TextBlock Text="L1" Canvas.Left="37" Canvas.Top="40" FontSize="9"
                           Foreground="{StaticResource TextDataBrush}" IsHitTestVisible="False"/>

                <Rectangle x:Name="BtnR1" Canvas.Left="285" Canvas.Top="38" Width="55" Height="14"
                           RadiusX="4" RadiusY="4" Fill="#3A3A3A"/>
                <TextBlock Text="R1" Canvas.Left="303" Canvas.Top="40" FontSize="9"
                           Foreground="{StaticResource TextDataBrush}" IsHitTestVisible="False"/>

                <!-- Touchpad, Share, Options, PS. -->
                <Rectangle x:Name="TouchpadArea" Canvas.Left="140" Canvas.Top="58" Width="80" Height="34"
                           RadiusX="6" RadiusY="6" Fill="#3A3A3A"
                           Stroke="{StaticResource BorderBrush}" StrokeThickness="1"/>

                <Rectangle x:Name="BtnShare" Canvas.Left="100" Canvas.Top="66" Width="26" Height="16"
                           RadiusX="3" RadiusY="3" Fill="#3A3A3A"/>
                <TextBlock Text="Share" Canvas.Left="99" Canvas.Top="85" FontSize="8"
                           Foreground="{StaticResource TextLabelBrush}" IsHitTestVisible="False"/>

                <Rectangle x:Name="BtnOptions" Canvas.Left="234" Canvas.Top="66" Width="26" Height="16"
                           RadiusX="3" RadiusY="3" Fill="#3A3A3A"/>
                <TextBlock Text="Options" Canvas.Left="228" Canvas.Top="85" FontSize="8"
                           Foreground="{StaticResource TextLabelBrush}" IsHitTestVisible="False"/>

                <Ellipse x:Name="BtnPS" Canvas.Left="168" Canvas.Top="100" Width="24" Height="24"
                         Fill="#3A3A3A" Stroke="{StaticResource BorderBrush}" StrokeThickness="1"/>
                <TextBlock Text="PS" Canvas.Left="172" Canvas.Top="106" FontSize="9"
                           Foreground="{StaticResource TextDataBrush}" IsHitTestVisible="False"/>

                <!-- Cruceta (dpad), cluster centrado en (55,150). -->
                <Rectangle x:Name="DpadUp" Canvas.Left="47" Canvas.Top="112" Width="16" Height="26"
                           RadiusX="3" RadiusY="3" Fill="#3A3A3A"/>
                <Rectangle x:Name="DpadDown" Canvas.Left="47" Canvas.Top="162" Width="16" Height="26"
                           RadiusX="3" RadiusY="3" Fill="#3A3A3A"/>
                <Rectangle x:Name="DpadLeft" Canvas.Left="17" Canvas.Top="142" Width="26" Height="16"
                           RadiusX="3" RadiusY="3" Fill="#3A3A3A"/>
                <Rectangle x:Name="DpadRight" Canvas.Left="67" Canvas.Top="142" Width="26" Height="16"
                           RadiusX="3" RadiusY="3" Fill="#3A3A3A"/>

                <!-- Pozos de stick: fijos, no cambian de Fill. Los pulgares se mueven en
                     Update() via Canvas.SetLeft/Top; la posicion aqui es solo el estado
                     de reposo (X=0,Y=0). -->
                <Ellipse x:Name="LeftStickWell" Canvas.Left="92" Canvas.Top="110" Width="80" Height="80"
                         Fill="{StaticResource SurfaceAltBrush}" Stroke="{StaticResource BorderBrush}" StrokeThickness="1"/>
                <Ellipse x:Name="LeftThumb" Canvas.Left="118" Canvas.Top="136" Width="28" Height="28"
                         Fill="{StaticResource TextDataBrush}" Stroke="{StaticResource BorderBrush}" StrokeThickness="1"/>

                <Ellipse x:Name="RightStickWell" Canvas.Left="188" Canvas.Top="110" Width="80" Height="80"
                         Fill="{StaticResource SurfaceAltBrush}" Stroke="{StaticResource BorderBrush}" StrokeThickness="1"/>
                <Ellipse x:Name="RightThumb" Canvas.Left="214" Canvas.Top="136" Width="28" Height="28"
                         Fill="{StaticResource TextDataBrush}" Stroke="{StaticResource BorderBrush}" StrokeThickness="1"/>

                <!-- Caras: cluster centrado en (305,150), simetrico al dpad. -->
                <Ellipse x:Name="BtnTriangle" Canvas.Left="293" Canvas.Top="112" Width="24" Height="24" Fill="#3A3A3A"/>
                <TextBlock Text="△" Canvas.Left="300" Canvas.Top="115" FontSize="13"
                           Foreground="{StaticResource TextLabelBrush}" IsHitTestVisible="False"/>

                <Ellipse x:Name="BtnCross" Canvas.Left="293" Canvas.Top="164" Width="24" Height="24" Fill="#3A3A3A"/>
                <TextBlock Text="✕" Canvas.Left="300" Canvas.Top="167" FontSize="13"
                           Foreground="{StaticResource TextLabelBrush}" IsHitTestVisible="False"/>

                <Ellipse x:Name="BtnSquare" Canvas.Left="269" Canvas.Top="138" Width="24" Height="24" Fill="#3A3A3A"/>
                <TextBlock Text="□" Canvas.Left="276" Canvas.Top="141" FontSize="13"
                           Foreground="{StaticResource TextLabelBrush}" IsHitTestVisible="False"/>

                <Ellipse x:Name="BtnCircle" Canvas.Left="317" Canvas.Top="138" Width="24" Height="24" Fill="#3A3A3A"/>
                <TextBlock Text="○" Canvas.Left="324" Canvas.Top="141" FontSize="13"
                           Foreground="{StaticResource TextLabelBrush}" IsHitTestVisible="False"/>

            </Canvas>
        </Viewbox>
    </Border>
</UserControl>
